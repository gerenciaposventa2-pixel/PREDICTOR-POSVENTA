  document.getElementById('btnSaveTip').addEventListener('click', async ()=>{
    const sel = document.getElementById('tipSelect').value;
    const errEl = document.getElementById('tipErr');
    if(!sel){ errEl.textContent = 'Seleccione una tipificación antes de guardar.'; errEl.hidden=false; return; }
    const meta = TIP_BY_VALUE[sel];
    const esAgendado = meta.categoria === 'agendado';
    const fechaCita = document.getElementById('tipProxima').value || null;
    const horaCita = document.getElementById('tipHoraCita').value || null;
    const asesorSel = document.getElementById('tipAsesorServicio').value || '';
    if(esAgendado && (!fechaCita || !horaCita)){
      errEl.textContent = 'Para un agendamiento indique la fecha y la hora de la cita.';
      errEl.hidden = false;
      return;
    }
    if(esAgendado && !asesorSel){
      errEl.textContent = 'Seleccione el Asesor de Servicio para poder validar el cupo disponible.';
      errEl.hidden = false;
      return;
    }
    if(esAgendado){
      const asesorObj = agendaConfig.asesores.find(a=>a.nombre===asesorSel);
      if(!asesorObj){
        errEl.textContent = 'El asesor seleccionado ya no existe en la configuración de agenda.';
        errEl.hidden = false;
        return;
      }
      if(!(asesorObj.diasDisponibles||[]).includes(fechaCita)){
        errEl.textContent = `${asesorObj.nombre} no tiene el ${fechaCita} habilitado en su calendario de disponibilidad.`;
        errEl.hidden = false;
        return;
      }
      const topeEfectivo = getEffectiveCupos(asesorObj, fechaCita);
      const citasEseDia = citasCountForDate(asesorObj.nombre, fechaCita, currentTipPlaca);
      if(citasEseDia >= topeEfectivo){
        errEl.textContent = `${asesorObj.nombre} ya alcanzó su tope de ${topeEfectivo} cita(s) para el ${fechaCita}. Elija otra fecha u otro asesor.`;
        errEl.hidden = false;
        return;
      }
      const slotsAsesor = computeSlotsForAsesor(asesorObj, fechaCita);
      if(!slotsAsesor.includes(horaCita)){
        errEl.textContent = 'Esa hora no corresponde a un espacio válido de este asesor (revise el horario, la periodicidad o el almuerzo configurado) — elija una de la lista de horarios disponibles.';
        errEl.hidden = false;
        return;
      }
      const cargaNueva = getCarga(asesorObj, sel);
      if(cargaNueva<=0){
        errEl.textContent = `${asesorObj.nombre} no tiene cupo asignado para "${meta.label}" (carga en 0 en el reparto). Ajústelo en Configuración de agenda antes de agendar este tipo.`;
        errEl.hidden = false;
        return;
      }
      const cabe = slotFits(asesorObj, fechaCita, horaCita, cargaNueva, currentTipPlaca);
      if(!cabe){
        errEl.textContent = `Ese horario ya está ocupado o no alcanza los ${cargaNueva} espacio(s) consecutivos que requiere "${meta.label}". Elija otro horario de la lista.`;
        errEl.hidden = false;
        return;
      }
    }
    const v = analyzed.find(a=>a.placa===currentTipPlaca);
    const agente = document.getElementById('tipAgente').value.trim();
    const data = {
      placa: currentTipPlaca,
      cliente: v ? v.cliente : '',
      tipificacion: sel,
      tipificacionLabel: meta.label,
      categoria: meta.categoria,
      observacion: document.getElementById('tipObs').value.trim(),
      proximaGestion: fechaCita,
