    document.getElementById('legend').innerHTML = `
      <span><i style="background:var(--critical)"></i>Vencido (${vencidos})</span>
      <span><i style="background:var(--warn)"></i>Próximo (${proximos})</span>
      <span><i style="background:var(--ok)"></i>Al día (${aldia})</span>
      <span><i style="background:var(--neutral-status)"></i>Nunca ingresó (${nunca})</span>
    `;
