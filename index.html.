      catch(e){ alert('No se pudo guardar la agenda en la base compartida (' + ((e && e.message) || e) + '). Quedó guardada solo en este navegador y el equipo no la verá. Si el motivo es el tamaño, reduzca las semanas configuradas por asesor.'); }
