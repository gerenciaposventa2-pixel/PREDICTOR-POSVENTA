        renderResults();
      }
      closeTipModal();
    }catch(err){
      errEl.textContent = 'No se pudo guardar en la base compartida (' + err.message + '). Se guardó localmente en su lugar.';
      errEl.hidden = false;
      saveLocalGestion(currentTipPlaca, data);
      renderResults();
