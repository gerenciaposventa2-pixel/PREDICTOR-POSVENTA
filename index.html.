  // Gerencia/Gerente Posventa y Administrador. Asesor de Servicio, Asistente Posventa y Auditor no.
  const DEFAULT_TIPIFICA_ROLES = ['administrador','gerente_posventa','gerencia','jefe_taller','agente_call_center','asesor'];
  let rolePermisos = null; // cuando se carga, sobreescribe los valores por defecto para los roles editables — { [rol]: {tabs:[...], tipifica:bool} }

  function roleLabel(rol){ return ROLE_LABELS[rol] || rol; }
  function rolePermisoEntry(rol){
    const raw = rolePermisos && rolePermisos[rol];
    if(!raw) return null;
    if(Array.isArray(raw)) return { tabs: raw, tipifica: null }; // formato antiguo (solo pestañas)
    return raw;
  }
  function tabsForRole(rol){
    if(rol==='administrador') return DEFAULT_ROLE_TAB_ACCESS[rol];
    const entry = rolePermisoEntry(rol);
    if(entry && Array.isArray(entry.tabs)){
      // permisos guardados antes de que existieran las pestañas Confirmación y Citas: se les suman según el rol por defecto
      if((entry.v||1) < 2){
        const nuevas = (DEFAULT_ROLE_TAB_ACCESS[rol]||[]).filter(t=>['confirmacion','citas'].includes(t) && !entry.tabs.includes(t));
        return entry.tabs.concat(nuevas);
      }
      return entry.tabs;
    }
    return DEFAULT_ROLE_TAB_ACCESS[rol] || ['resultados'];
  }
  function canManageUsers(rol){ return tabsForRole(rol).includes('usuarios'); }
  function canTipificar(rol){
    if(rol==='administrador') return true;
    const entry = rolePermisoEntry(rol);
    if(entry && entry.tipifica!=null) return !!entry.tipifica;
    return DEFAULT_TIPIFICA_ROLES.includes(rol);
  }

  const LOCAL_ROLES_KEY = 'predictor-posventa-roles';
  function loadLocalRolePermisos(){
    try{ rolePermisos = JSON.parse(localStorage.getItem(LOCAL_ROLES_KEY) || 'null'); }catch(e){ rolePermisos = null; }
  }
  function saveLocalRolePermisos(){
    try{ localStorage.setItem(LOCAL_ROLES_KEY, JSON.stringify(rolePermisos||{})); }catch(e){}
  }
  async function persistRolePermisos(){
    if(dbApi){ try{ await dbApi.doc('config/roles').set(rolePermisos||{}); return true; }catch(e){ /* cae a local */ } }
    saveLocalRolePermisos();
    return false;
  }
  async function initRolesStore(){
    const goLocal = ()=>{ loadLocalRolePermisos(); renderRolePermisosGrid(); };
    if(!(window.claude && typeof window.claude.use === 'function')){ goLocal(); return; }
    try{ dbApi = dbApi || await window.claude.use('db'); }catch(e){ dbApi = dbApi || null; }
    updateGlobalStorageBanner();
    if(!dbApi){ goLocal(); return; }
    dbApi.doc('config/roles').onSnapshot(snap=>{
      rolePermisos = snap.exists ? deepClean(snap.data()) : null;
      renderRolePermisosGrid();
      if(currentUser){ applySessionUI(); renderTable(); renderRecuperacion(); } // refleja lo guardado en la sesión abierta
    }, err=>{ console.warn('db roles error', err); });
  }
  // los cambios de permisos se acumulan en un borrador local y solo se guardan al presionar el botón.
  let rolePermisosDraft = {};
  function renderRolePermisosGrid(){
    rolePermisosDraft = {};
    EDITABLE_ROLES.forEach(rol=>{ rolePermisosDraft[rol] = { tabs: tabsForRole(rol).slice(), tipifica: canTipificar(rol) }; });
    pintarRolePermisosGrid();
  }
  function pintarRolePermisosGrid(){
    const el = document.getElementById('rolePermisosGrid');
    el.innerHTML = EDITABLE_ROLES.map(rol=>{
      const draft = rolePermisosDraft[rol];
      const chips = ALL_TABS.map(t=>
        `<label class="perm-chip"><input type="checkbox" data-role="${rol}" data-tab="${t}" ${draft.tabs.includes(t)?'checked':''}>${TAB_LABELS[t]}</label>`
      ).join('');
      const tipificaChip = `<label class="perm-chip perm-chip-tipifica"><input type="checkbox" data-role="${rol}" data-tab="tipifica" ${draft.tipifica?'checked':''}><strong>Tipificar gestiones</strong></label>`;
      return `<div class="role-perm-card"><div class="role-perm-name">${roleLabel(rol)}</div><div class="role-perm-chips">${chips}${tipificaChip}</div></div>`;
    }).join('');
  }
  document.getElementById('rolePermisosGrid').addEventListener('change', e=>{
    const inp = e.target.closest('input[data-role]'); if(!inp) return;
    const rol = inp.dataset.role, tab = inp.dataset.tab;
    const draft = rolePermisosDraft[rol];
    if(tab==='tipifica'){
      draft.tipifica = inp.checked;
    } else if(inp.checked){
      if(!draft.tabs.includes(tab)) draft.tabs.push(tab);
    } else {
      draft.tabs = draft.tabs.filter(t=>t!==tab);
    }
    document.getElementById('permisosOk').hidden = true;
  });
  document.getElementById('btnGuardarPermisos').addEventListener('click', async ()=>{
    rolePermisos = { ...(rolePermisos||{}) };
    EDITABLE_ROLES.forEach(rol=>{ rolePermisos[rol] = { tabs: rolePermisosDraft[rol].tabs.slice(), tipifica: 
rolePermisosDraft[rol].tipifica, v: 2 }; });
    const btn = document.getElementById('btnGuardarPermisos');
    btn.disabled = true; btn.textContent = 'Guardando…';
    const compartido = await persistRolePermisos();
    btn.disabled = false; btn.textContent = 'Guardar permisos';
    const okEl = document.getElementById('permisosOk');
    okEl.textContent = compartido
      ? 'Permisos guardados correctamente en la base compartida — ya aplican para todo el equipo.'
      : 'Permisos guardados SOLO en este navegador (no hay conexión a la base compartida) — el resto del equipo no verá este cambio hasta que se guarde desde un dispositivo conectado.';
    okEl.hidden = false;
    if(currentUser){ applySessionUI(); renderTable(); renderRecuperacion(); }
  });

  function loadLocalUsers(){
    try{
      const raw = JSON.parse(localStorage.getItem(LOCAL_USERS_KEY) || '{}');
      usersConfig = { usuarios: Array.isArray(raw.usuarios) ? raw.usuarios : [] };
    }catch(e){ usersConfig = { usuarios: [] }; }
  }
  function saveLocalUsers(){
    try{ localStorage.setItem(LOCAL_USERS_KEY, JSON.stringify(usersConfig)); }catch(e){}
  }
  async function persistUsers(){
    if(dbApi){ try{ await dbApi.doc('config/usuarios').set(usersConfig); return true; }catch(e){ /* cae a local */ } }
    saveLocalUsers();
    return false;
  }
  async function initUsersStore(){
    const note = document.getElementById('usuariosStorageNote');
    const onReady = ()=>{
      usersStoreReady = true;
      actualizarSetupVisible();
      renderUsuariosList();
      attemptAutoLogin();
    };
    const goLocal = ()=>{ note.textContent = 'Guardado localmente en este navegador (no se comparte con otros equipos).'; loadLocalUsers(); onReady(); };
    if(!(window.claude && typeof window.claude.use === 'function')){ goLocal(); return; }
    try{ dbApi = dbApi || await window.claude.use('db'); }catch(e){ dbApi = dbApi || null; }
    updateGlobalStorageBanner();
    if(!dbApi){ goLocal(); return; }
    note.textContent = 'Los usuarios se guardan en la base compartida — visibles para todo el equipo.';
    dbApi.doc('config/usuarios').onSnapshot(snap=>{
      const data = snap.exists ? deepClean(snap.data()) : {};
      usersConfig = { usuarios: Array.isArray(data.usuarios) ? data.usuarios : [] };
      if(!usersStoreReady) onReady(); else { renderUsuariosList(); actualizarSetupVisible(); }
    }, err=>{ console.warn('db usuarios error', err); if(!usersStoreReady) onReady(); });
  }

  // ---------- seguridad de acceso: contraseñas con hash, bloqueo por intentos y sesión con vencimiento ----------
  const PBKDF2_ITER = 150000;
  const IDLE_MS = 30*60*1000;
  const INTENTOS_KEY = 'predictor-posventa-intentos', MAX_INTENTOS = 5, BLOQUEO_MS = 5*60*1000, VENTANA_MS = 15*60*1000;
  function bytesToHex(buf){ return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join(''); }
  function hexToBytes(h){ const a = new Uint8Array(h.length/2); for(let i=0;i<a.length;i++) a[i] = parseInt(h.substr(i*2,2),16); return a; }
  async function derivarHash(clave, saltHex, iter){
    if(!(window.crypto && crypto.subtle)) throw new Error('crypto no disponible');
    const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(clave), 'PBKDF2', false, ['deriveBits']);
    const bits = await crypto.subtle.deriveBits({ name:'PBKDF2', hash:'SHA-256', salt:hexToBytes(saltHex), iterations:iter }, key, 256);
    return bytesToHex(bits);
  }
  async function crearCredencial(clave){
    const salt = bytesToHex(crypto.getRandomValues(new Uint8Array(16)));
    return { salt, iter:PBKDF2_ITER, hash: await derivarHash(clave, salt, PBKDF2_ITER) };
  }
  async function verificarClave(u, clave){
    if(u.hash && u.salt) return (await derivarHash(clave, u.salt, u.iter || PBKDF2_ITER)) === u.hash;
    return typeof u.clave === 'string' && u.clave === clave; // formato antiguo: se convierte a hash cuando ingresa un administrador
  }
  function leerIntentos(){ try{ return JSON.parse(localStorage.getItem(INTENTOS_KEY)||'{}'); }catch(e){ return {}; } }
  function guardarIntentos(o){ try{ localStorage.setItem(INTENTOS_KEY, JSON.stringify(o)); }catch(e){} }
  function minutosBloqueo(login){
    const o = leerIntentos()[norm(login)];
    return (o && o.hasta && o.hasta > Date.now()) ? Math.ceil((o.hasta-Date.now())/60000) : 0;
  }
  function registrarFallo(login){
    const k = norm(login), all = leerIntentos(), now = Date.now();
    const o = all[k] || { n:0, t:0 };
    if(now - o.t > VENTANA_MS) o.n = 0;
    o.n++; o.t = now;
    if(o.n >= MAX_INTENTOS){ o.hasta = now + BLOQUEO_MS; o.n = 0; }
    all[k] = o; guardarIntentos(all);
  }
  function limpiarFallos(login){ const all = leerIntentos(); delete all[norm(login)]; guardarIntentos(all); }

  // convierte a hash las contraseñas que aún estén guardadas en el formato antiguo (texto plano);
  // solo lo hace quien puede administrar usuarios, porque requiere permiso de escritura.
  async function migrarClavesLegacy(){
    if(!currentUser || !canManageUsers(currentUser.rol)) return;
    if(!usersConfig.usuarios.some(u=>u.clave && !u.hash)) return;
    try{
      const usuarios = [];
      for(const u of usersConfig.usuarios){
        if(u.clave && !u.hash){
          const cred = await crearCredencial(u.clave);
          const { clave, ...resto } = u;
          usuarios.push({ ...resto, ...cred });
        } else usuarios.push(u);
      }
      if(dbApi) await dbApi.doc('config/usuarios').set({ usuarios });
      usersConfig = { usuarios };
      if(!dbApi) saveLocalUsers();
      renderUsuariosList();
    }catch(e){ console.warn('no se pudo cifrar las contraseñas antiguas', e); }
  }

  function findUsuario(login){
    const n = norm(login||'');
    return usersConfig.usuarios.find(u=>norm(u.usuario)===n);
  }

  // primer uso: si no existe ningún usuario se pide crear el administrador (no hay claves por defecto)
  function actualizarSetupVisible(){
    const vacio = usersStoreReady && usersConfig.usuarios.length === 0;
    document.getElementById('setupBox').hidden = !vacio;
    document.getElementById('loginForm').hidden = vacio;
  }
  document.getElementById('btnSetupAdmin').addEventListener('click', async ()=>{
    const errEl = document.getElementById('setupErr');
    const nombre = document.getElementById('setupNombre').value.trim();
    const login = document.getElementById('setupUsuario').value.trim();
    const clave = document.getElementById('setupClave').value;
    const clave2 = document.getElementById('setupClave2').value;
    if(!nombre || !login){ errEl.textContent = 'Ingrese su nombre y un nombre de usuario.'; errEl.hidden = false; return; }
    if(clave.length < 8){ errEl.textContent = 'La contraseña debe tener al menos 8 caracteres.'; errEl.hidden = false; return; }
    if(clave !== clave2){ errEl.textContent = 'Las contraseñas no coinciden.'; errEl.hidden = false; return; }
    try{
      const cred = await crearCredencial(clave);
      usersConfig = { usuarios: [{ nombre, usuario:login, rol:'administrador', ...cred }] };
      const compartido = await persistUsers();
      if(dbApi && !compartido){ usersConfig = { usuarios: [] }; errEl.textContent = 'No se pudo guardar en la base compartida. Solo el propietario del artefacto (o quien tenga permiso de edición) puede crear el primer administrador.'; errEl.hidden = false; return; }
    }catch(e){ errEl.textContent = 'No se pudo crear la cuenta en este navegador.'; errEl.hidden = false; return; }
    errEl.hidden = true;
    ['setupNombre','setupUsuario','setupClave','setupClave2'].forEach(id=>{ document.getElementById(id).value=''; });
    actualizarSetupVisible();
    loginAs(usersConfig.usuarios[0]);
  });

  // sesión: vive solo mientras la pestaña esté abierta y se cierra sola tras 30 min sin actividad
  let idleTimer = null, lastActivity = 0;
  function guardarSesion(login){ try{ sessionStorage.setItem(SESSION_KEY, JSON.stringify({ u:login, t:Date.now() })); }catch(e){} }
  function actividad(){
    if(!currentUser) return;
    const now = Date.now();
    if(now - lastActivity < 5000) return;
    lastActivity = now;
    guardarSesion(currentUser.usuario);
    clearTimeout(idleTimer);
    idleTimer = setTimeout(()=>cerrarSesion('Su sesión se cerró por inactividad (30 minutos). Ingrese de nuevo.'), IDLE_MS);
  }
  ['click','keydown','mousemove','touchstart','scroll'].forEach(ev=>document.addEventListener(ev, actividad, {passive:true}));

  function loginAs(u){
    currentUser = { nombre:u.nombre, usuario:u.usuario, rol:u.rol };
    try{ localStorage.removeItem(SESSION_KEY); }catch(e){}
    lastActivity = 0; actividad();
    document.getElementById('loginClave').value = '';
    document.getElementById('loginOverlay').hidden = true;
    document.getElementById('appRoot').hidden = false;
    applySessionUI();
    // las tablas ya se habían dibujado (con la sesión aún sin definir) antes de ingresar — hay que
    // volver a pintarlas ahora que currentUser tiene el rol real, para que el botón de tipificar
    // (y cualquier otro control que dependa del rol) refleje el permiso correcto desde el primer vistazo.
    renderResults();
  }
  function cerrarSesion(msg){
    currentUser = null;
    clearTimeout(idleTimer);
    try{ sessionStorage.removeItem(SESSION_KEY); localStorage.removeItem(SESSION_KEY); }catch(e){}
    document.getElementById('sessionInfo').hidden = true;
    document.getElementById('loginUsuario').value = '';
    document.getElementById('loginClave').value = '';
    const errEl = document.getElementById('loginErr');
    errEl.textContent = msg || ''; errEl.hidden = !msg;
    document.getElementById('appRoot').hidden = true;
    document.getElementById('loginOverlay').hidden = false;
    renderResults();
  }
  function attemptAutoLogin(){
    const loginBtn = document.getElementById('btnLogin');
    loginBtn.disabled = false; loginBtn.textContent = 'Ingresar';
    let ses = null; try{ ses = JSON.parse(sessionStorage.getItem(SESSION_KEY)||'null'); }catch(e){}
    const u = (ses && ses.u && (Date.now() - ses.t) < IDLE_MS) ? findUsuario(ses.u) : null;
    if(u) loginAs(u);
  }
  function applySessionUI(){
    const label = document.getElementById('sessionUserLabel');
    label.innerHTML = `<strong>${currentUser.nombre}</strong> · ${roleLabel(currentUser.rol)}`;
    document.getElementById('sessionInfo').hidden = false;
    const permitidas = tabsForRole(currentUser.rol);
    document.querySelectorAll('#fileTabs .filetab').forEach(btn=>{
      btn.hidden = !permitidas.includes(btn.dataset.tab);
    });
    activateTab(permitidas.includes('paso1') ? 'paso1' : (permitidas[0] || 'resultados'));
  }

  document.getElementById('btnLogin').addEventListener('click', async ()=>{
    const errEl = document.getElementById('loginErr');
    const login = document.getElementById('loginUsuario').value.trim();
    const clave = document.getElementById('loginClave').value;
    if(!usersStoreReady){ errEl.textContent = 'Cargando usuarios, intente de nuevo en un momento.'; errEl.hidden=false; return; }
    if(!login || !clave){ errEl.textContent = 'Ingrese usuario y contraseña.'; errEl.hidden=false; return; }
    const espera = minutosBloqueo(login);
    if(espera){ errEl.textContent = `Demasiados intentos fallidos. Intente de nuevo en ${espera} min.`; errEl.hidden=false; return; }
    const btn = document.getElementById('btnLogin'); btn.disabled = true;
    let ok = false; const u = findUsuario(login);
    try{
      ok = u ? await verificarClave(u, clave) : (await derivarHash(clave, '00000000000000000000000000000000', PBKDF2_ITER), false);
    }catch(e){
      btn.disabled = false;
      errEl.textContent = 'Este navegador no permite verificar contraseñas de forma segura. Abra el artefacto desde su enlace https.'; errEl.hidden = false; return;
    }
    btn.disabled = false;
    if(!ok){
      registrarFallo(login);
      const w = minutosBloqueo(login);
      errEl.textContent = w ? `Demasiados intentos fallidos. Intente de nuevo en ${w} min.` : 'Usuario o contraseña incorrectos.';
      errEl.hidden = false; return;
    }
    limpiarFallos(login);
    errEl.hidden = true;
    loginAs(u);
    migrarClavesLegacy();
  });
  ['loginUsuario','loginClave'].forEach(id=>{
    document.getElementById(id).addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); document.getElementById('btnLogin').click(); } });
  });
  document.getElementById('btnLogout').addEventListener('click', ()=>cerrarSesion());

  // hasta que la lista de usuarios cargue, el formulario de ingreso queda deshabilitado
  document.getElementById('btnLogin').disabled = true;
  document.getElementById('btnLogin').textContent = 'Cargando…';

  // usuarios: alta / edición / baja (pestaña Usuarios, solo administradores)
  let editingUsuarioLogin = null;
  function resetUsuarioForm(){
    editingUsuarioLogin = null;
    document.getElementById('userFormTitle').textContent = 'Agregar usuario';
    document.getElementById('btnAddUsuario').textContent = 'Agregar usuario';
    document.getElementById('btnCancelEditUsuario').hidden = true;
    document.getElementById('nuevoUsuarioNombre').value = '';
    document.getElementById('nuevoUsuarioLogin').value = '';
    document.getElementById('nuevoUsuarioClave').value = '';
    document.getElementById('nuevoUsuarioClave').placeholder = 'Mínimo 8 caracteres';
    document.getElementById('nuevoUsuarioRol').value = 'agente_call_center';
    document.getElementById('usuarioFormErr').hidden = true;
  }
  function renderUsuariosList(){
    const el = document.getElementById('usuariosList');
    if(!usersConfig.usuarios.length){ el.innerHTML = '<span class="agenda-empty">Aún no hay usuarios registrados.</span>'; return; }
    el.innerHTML = usersConfig.usuarios.map(u=>`<div class="asesor-card">
      <span class="ac-name">${u.nombre}</span>
      <span class="ac-taller">@${u.usuario}</span>
      <span class="ac-detail">${roleLabel(u.rol)}${(u.clave && !u.hash) ? ' · contraseña sin cifrar (se cifra al ingresar un administrador)' : ''}</span>
      <div class="ac-actions">
        <button type="button" data-edit-usuario="${u.usuario}">Editar</button>
        <button type="button" class="danger" data-remove-usuario="${u.usuario}">Eliminar</button>
      </div>
    </div>`).join('');
  }
  document.getElementById('btnAddUsuario').addEventListener('click', async ()=>{
    const errEl = document.getElementById('usuarioFormErr');
    const okEl = document.getElementById('usuarioFormOk');
    okEl.hidden = true;
    const nombre = document.getElementById('nuevoUsuarioNombre').value.trim();
    const login = document.getElementById('nuevoUsuarioLogin').value.trim();
    const clave = document.getElementById('nuevoUsuarioClave').value;
    const rol = document.getElementById('nuevoUsuarioRol').value;
    if(!nombre){ errEl.textContent='Ingrese el nombre completo.'; errEl.hidden=false; return; }
    if(!login){ errEl.textContent='Ingrese el nombre de usuario.'; errEl.hidden=false; return; }
    const previo = editingUsuarioLogin ? usersConfig.usuarios.find(u=>norm(u.usuario)===norm(editingUsuarioLogin)) : null;
    if(!previo && !clave){ errEl.textContent='Ingrese una contraseña.'; errEl.hidden=false; return; }
    if(clave && clave.length<8){ errEl.textContent='La contraseña debe tener al menos 8 caracteres.'; errEl.hidden=false; return; }
    const dup = usersConfig.usuarios.find(u=>norm(u.usuario)===norm(login) && norm(u.usuario)!==norm(editingUsuarioLogin||''));
    if(dup){ errEl.textContent='Ya existe un usuario con ese nombre de usuario.'; errEl.hidden=false; return; }
    errEl.hidden = true;
    const eraEdicion = !!editingUsuarioLogin;
    let cred;
    try{ cred = clave ? await crearCredencial(clave) : (previo.hash ? { salt:previo.salt, iter:previo.iter, hash:previo.hash } : { clave:previo.clave }); }
    catch(e){ errEl.textContent='Este navegador no permite cifrar la contraseña. Abra el artefacto desde su enlace https.'; errEl.hidden=false; return; }
    const record = { nombre, usuario:login, rol, ...cred };
    let usuarios = usersConfig.usuarios.slice();
    if(editingUsuarioLogin){
      usuarios = usuarios.map(u=> norm(u.usuario)===norm(editingUsuarioLogin) ? record : u);
    } else {
      usuarios.push(record);
    }
    usersConfig = { usuarios };
    const compartido = await persistUsers();
    renderUsuariosList();
    if(currentUser && norm(currentUser.usuario)===norm(editingUsuarioLogin||'')){
      currentUser = { nombre:record.nombre, usuario:record.usuario, rol:record.rol };
      applySessionUI();
      renderResults();
    }
    resetUsuarioForm();
    okEl.textContent = compartido
      ? `Usuario "${nombre}" ${eraEdicion?'actualizado':'agregado'} correctamente en la base compartida.`
      : `Usuario "${nombre}" ${eraEdicion?'actualizado':'agregado'} SOLO en este navegador (sin conexión a la base compartida o sin permiso de edición) — no podrá iniciar sesión desde otro equipo hasta que se guarde con conexión.`;
    okEl.hidden = false;
  });
  document.getElementById('btnCancelEditUsuario').addEventListener('click', resetUsuarioForm);
  document.getElementById('usuariosList').addEventListener('click', e=>{
    const editBtn = e.target.closest('button[data-edit-usuario]');
    const removeBtn = e.target.closest('button[data-remove-usuario]');
    if(editBtn){
      const u = usersConfig.usuarios.find(x=>x.usuario===editBtn.dataset.editUsuario);
      if(!u) return;
      editingUsuarioLogin = u.usuario;
      document.getElementById('userFormTitle').textContent = 'Editar usuario';
      document.getElementById('btnAddUsuario').textContent = 'Actualizar usuario';
      document.getElementById('btnCancelEditUsuario').hidden = false;
      document.getElementById('nuevoUsuarioNombre').value = u.nombre;
      document.getElementById('nuevoUsuarioLogin').value = u.usuario;
      document.getElementById('nuevoUsuarioClave').value = '';
      document.getElementById('nuevoUsuarioClave').placeholder = 'Dejar vacío para conservar la actual';
      document.getElementById('nuevoUsuarioRol').value = u.rol;
      document.getElementById('usuarioFormErr').hidden = true;
      document.getElementById('usuarioFormOk').hidden = true;
    } else if(removeBtn){
      const login = removeBtn.dataset.removeUsuario;
      const u = usersConfig.usuarios.find(x=>x.usuario===login);
      const admins = usersConfig.usuarios.filter(x=>canManageUsers(x.rol));
      if(u && canManageUsers(u.rol) && admins.length<=1){
        alert('No se puede eliminar el único usuario que puede gestionar usuarios (Administrador o Gerente Posventa) — cree otro primero.');
        return;
      }
      usersConfig = { usuarios: usersConfig.usuarios.filter(x=>x.usuario!==login) };
      persistUsers();
      renderUsuariosList();
      if(editingUsuarioLogin===login) resetUsuarioForm();
    }
  });

  // ---------- base de vehículos compartida: lo que se carga desde Excel queda guardado para todo el equipo ----------
  const BASE_CHUNK_BYTES = 180000; // cada documento de la base compartida admite 256 KiB
  let baseMetaCurrent = {}, baseVersionLocal = 0;
  function diasDeFecha(d){ return Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())/86400000); }
  function fechaDeDias(n){ const u = new Date(n*86400000); return new Date(u.getUTCFullYear(), u.getUTCMonth(), u.getUTCDate()); }
  function packIng(r){ return [r.cliente, r.telefono, r.placa, r.marca, r.modelo, r.vin||'', r.correo||'', diasDeFecha(r.fecha), r.km]; }
  function unpackIng(a){ return { cliente:a[0], telefono:a[1], placa:a[2], marca:a[3], modelo:a[4], vin:a[5], correo:a[6], fecha:fechaDeDias(a[7]), km:a[8] }; }
  function packVen(r){ return [r.cliente, r.telefono, r.placa, r.marca, r.modelo, r.vin||'', r.correo||'', diasDeFecha(r.fecha_venta)]; }
  function unpackVen(a){ return { cliente:a[0], telefono:a[1], placa:a[2], marca:a[3], modelo:a[4], vin:a[5], correo:a[6], fecha_venta:fechaDeDias(a[7]) }; }
  function chunkRows(rows){
    const chunks = []; let cur = [], size = 0;
    rows.forEach(r=>{
      const s = JSON.stringify(r).length + 1;
      if(size + s > BASE_CHUNK_BYTES && cur.length){ chunks.push(cur); cur = []; size = 0; }
      cur.push(r); size += s;
    });
    if(cur.length) chunks.push(cur);
    return chunks;
  }
  // guarda en la base compartida el conjunto de registros ya confirmado ('ing' = ingresos, 'ven' = ventas)
  async function guardarBaseCompartida(tipo){
    const msgEl = document.getElementById(tipo==='ing' ? 'confirmIngresos' : 'confirmVentas');
    if(!dbApi){ msgEl.textContent += ' Quedó solo en este navegador (sin conexión a la base compartida o sin permiso de edición): el resto del equipo no la verá.'; return; }
    const recs = tipo==='ing' ? dsIngresos.records : dsVentas.records;
    try{
      const chunks = chunkRows(recs.map(tipo==='ing' ? packIng : packVen));
      for(let i=0; i<chunks.length; i++) await dbApi.doc(`base/${tipo}_${i}`).set({ rows: chunks[i] });
      const prev = baseMetaCurrent[tipo] || 0;
      for(let i=chunks.length; i<prev; i++) await dbApi.doc(`base/${tipo}_${i}`).delete();
      const meta = { ...baseMetaCurrent, [tipo]: chunks.length, [tipo+'Total']: recs.length, version: Date.now(), actualizadoPor: currentUser ? currentUser.nombre : '', actualizadoEl: new Date().toISOString() };
      await dbApi.doc('base/meta').set(meta);
      baseVersionLocal = meta.version; baseMetaCurrent = meta;
      msgEl.textContent += ' Guardada en la base compartida: todo el equipo ya la ve.';
    }catch(e){
      msgEl.textContent += ' No se pudo guardar en la base compartida (' + ((e && e.message) || e) + '). Verifique que su cuenta de claude.ai tenga permiso de edición sobre el artefacto.';
      msgEl.classList.add('err');
    }
  }
  async function cargarBaseDesdeDb(){
    const snap = await dbApi.collection('base').get();
    const docs = snap.docs.filter(d=>d.exists).map(d=>({ id:d.id, data:deepClean(d.data()) }));
    const partes = t=>docs.filter(d=>d.id.indexOf(t+'_')===0).sort((a,b)=>(+a.id.split('_')[1])-(+b.id.split('_')[1]));
    const ing = [], ven = [];
    partes('ing').forEach(d=>(d.data.rows||[]).forEach(r=>ing.push(unpackIng(r))));
    partes('ven').forEach(d=>(d.data.rows||[]).forEach(r=>ven.push(unpackVen(r))));
    dsIngresos.records = ing; dsVentas.records = ven;
    rebuildVehicles();
  }
  async function initBaseStore(){
    if(!(window.claude && typeof window.claude.use === 'function')) return;
    try{ dbApi = dbApi || await window.claude.use('db'); }catch(e){ dbApi = dbApi || null; }
    updateGlobalStorageBanner();
    if(!dbApi) return;
    dbApi.doc('base/meta').onSnapshot(async snap=>{
      const meta = snap.exists ? deepClean(snap.data()) : {};
      baseMetaCurrent = meta;
      if(!meta.version || meta.version === baseVersionLocal) return;
      baseVersionLocal = meta.version;
      try{
        await cargarBaseDesdeDb();
        const quien = meta.actualizadoPor ? ` por ${meta.actualizadoPor}` : '';
        const cuando = meta.actualizadoEl ? ` el ${fmtDate(new Date(meta.actualizadoEl))}` : '';
        [['confirmIngresos', `Base compartida cargada: ${meta.ingTotal||0} ingreso(s), actualizada${quien}${cuando}.`],
         ['confirmVentas', `Base compartida cargada: ${meta.venTotal||0} venta(s), actualizada${quien}${cuando}.`]].forEach(([id,txt])=>{
          const el = document.getElementById(id); el.textContent = txt; el.classList.remove('err');
        });
      }catch(e){ console.warn('no se pudo cargar la base compartida', e); }
    }, err=>{ console.warn('db base error', err); });
  }

  // ---------- periodicidad general compartida (antes era por navegador, y daba estados distintos a cada usuario) ----------
  function aplicarCfgGeneral(c){
    if(!c) return;
    document.getElementById('cfgKm').value = c.kmPeriod;
    document.getElementById('cfgMeses').value = c.monthsPeriod;
    document.getElementById('cfgAviso').value = Math.round(c.warnPct*100);
    document.getElementById('cfgKmDia').value = c.assumedKmDay;
    const r = document.querySelector(`input[name="regla"][value="${c.regla}"]`);
    if(r) r.checked = true;
  }
  async function initCfgStore(){
    if(!(window.claude && typeof window.claude.use === 'function')) return;
    try{ dbApi = dbApi || await window.claude.use('db'); }catch(e){ dbApi = dbApi || null; }
    if(!dbApi) return;
    dbApi.doc('config/periodicidad').onSnapshot(snap=>{
      if(!snap.exists) return;
      aplicarCfgGeneral(deepClean(snap.data()));
      generateResults();
    }, err=>{ console.warn('db periodicidad error', err); });
  }

  // ---------- arrastrar para desplazar: clic sostenido sobre una tabla (o la barra de pestañas) mueve el contenido ----------
  (function(){
    let box = null, x0 = 0, y0 = 0, sl0 = 0, st0 = 0, arrastro = false;
    const INTERACTIVO = 'button, a, input, select, textarea, label, .gestion-edit';
    document.addEventListener('mousedown', e=>{
      arrastro = false; // un arrastre anterior que terminó sin clic no debe tragarse el siguiente clic
      if(e.button !== 0) return;
      const c = e.target.closest('.table-wrap, .filetabs');
      if(!c) return;
      // en las tablas no se arranca el arrastre sobre botones o campos; en la barra de pestañas sí (casi todo son botones)
      if(c.classList.contains('table-wrap') && e.target.closest(INTERACTIVO)) return;
      box = c; x0 = e.clientX; y0 = e.clientY; sl0 = c.scrollLeft; st0 = window.scrollY; arrastro = false;
    });
    document.addEventListener('mousemove', e=>{
      if(!box) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if(!arrastro && Math.abs(dx) < 5 && Math.abs(dy) < 5) return;
      if(!arrastro){ arrastro = true; box.classList.add('arrastrando'); }
      e.preventDefault();
      box.scrollLeft = sl0 - dx;
      if(box.classList.contains('table-wrap')) window.scrollTo(window.scrollX, st0 - dy);
    });
    function fin(){ if(box){ box.classList.remove('arrastrando'); } box = null; }
    document.addEventListener('mouseup', fin);
    window.addEventListener('blur', fin);
    // si hubo arrastre real, no se dispara el clic (por ejemplo en una pestaña) al soltar
    document.addEventListener('click', e=>{ if(arrastro){ e.preventDefault(); e.stopPropagation(); arrastro = false; } }, true);
    document.addEventListener('dragstart', e=>{ if(box) e.preventDefault(); });
  })();

  // ---------- fichero: pestañas que muestran un módulo a la vez ----------
  function activateTab(tabId){
    document.querySelectorAll('#fileTabs .filetab').forEach(b=> b.setAttribute('aria-selected', String(b.dataset.tab===tabId)));
    document.querySelectorAll('.tabpanel').forEach(panel=>{ panel.hidden = (panel.id !== tabId); });
  }
  document.getElementById('fileTabs').addEventListener('click', e=>{
    const btn = e.target.closest('.filetab'); if(!btn) return;
    activateTab(btn.dataset.tab);
  });

  // initial render with sample data, then attach the gestión, agenda, usuarios and roles stores (local or shared)
  generateResults();
  initGestionStore();
  initAgendaStore();
  initUsersStore();
  initRolesStore();
  initMarcaPeriodicidadStore();
  initBaseStore();
  initCfgStore();
})();
</script>
