<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
(function(){
  "use strict";

  // ---------- helpers ----------
  function norm(s){
    s = (s==null?'':String(s)).toLowerCase().trim();
    return s.replace(/[áàäâã]/g,'a').replace(/[éèëê]/g,'e').replace(/[íìïî]/g,'i')
      .replace(/[óòöôõ]/g,'o').replace(/[úùüû]/g,'u').replace(/ñ/g,'n');
  }
  function fmtDate(d){ if(!d||isNaN(d)) return '—'; return d.toLocaleDateString('es-CO',{year:'numeric',month:'short',day:'2-digit'}); }
  function fmtInt(n){ if(n==null||isNaN(n)) return '—'; return Math.round(n).toLocaleString('es-CO'); }
  function diffDays(a,b){ return Math.round((b-a)/86400000); }
  function clampPct(x){ return Math.max(0, Math.min(100, x)); }

  const MESES_ES = {enero:0,ene:0,febrero:1,feb:1,marzo:2,mar:2,abril:3,abr:3,mayo:4,may:4,junio:5,jun:5,
    julio:6,jul:6,agosto:7,ago:7,septiembre:8,setiembre:8,sep:8,sept:8,octubre:9,oct:9,noviembre:10,nov:10,diciembre:11,dic:11};

  function parseDateFlexible(v){
    if(v==null||v==='') return null;
    if(v instanceof Date && !isNaN(v)) return v;
    if(typeof v === 'number'){
      const d = XLSX.SSF ? XLSX.SSF.parse_date_code(v) : null;
      if(d) return new Date(Date.UTC(d.y,d.m-1,d.d));
    }
    const s = String(v).trim();
    let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
    if(m) return new Date(+m[1], +m[2]-1, +m[3]);
    m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
    if(m){
      let dd=+m[1], mm=+m[2], yy=+m[3]; if(yy<100) yy+=2000;
      return new Date(yy, mm-1, dd);
    }
    m = s.match(/^(\d{1,2})\s*(?:de)?\s*([a-zA-Zñáéíóúü]+)\.?\s*(?:de|,)?\s*(\d{2,4})/i);
    if(m){
      const mes = MESES_ES[norm(m[2])];
      if(mes!=null){
        let yy=+m[3]; if(yy<100) yy+=2000;
        return new Date(yy, mes, +m[1]);
      }
    }
    const t = Date.parse(s);
    return isNaN(t) ? null : new Date(t);
  }
  function parseKm(v){
    if(v==null||v==='') return null;
    if(typeof v === 'number') return v;
    const digits = String(v).replace(/[^\d]/g,'');
    return digits === '' ? null : parseInt(digits,10);
  }

  const GUESS = {
    cliente:['cliente','nombre cliente','razon social','propietario','nombre'],
    telefono:['telefono','celular','movil','contacto','tel'],
    placa:['placa','matricula','patente'],
    marca:['marca','fabricante','brand'],
    modelo:['modelo','linea','vehiculo'],
    vin:['vin','chasis','numero de chasis','no chasis','serie'],
    correo:['correo','correo electronico','email','e-mail'],
    fecha:['fecha ingreso','fecha de ingreso','fecha entrada','fecha orden','fecha de orden','fecha'],
    km:['kilometraje','kilometros','km actual','km'],
    fecha_venta:['fecha venta','fecha de venta','fecha entrega','fecha facturacion']
  };
  function guessHeader(headers, keys){
    for(const k of keys){ const hit = headers.find(h=>norm(h)===k); if(hit) return hit; }
    for(const k of keys){ const hit = headers.find(h=>norm(h).includes(k)); if(hit) return hit; }
    return '';
  }

  const isFilled = v => String(v==null?'':v).trim() !== '';
  const FIELD_LABELS_ING = [
    ['cliente','Cliente',true,isFilled],['telefono','Teléfono',false,null],['placa','Placa',true,isFilled],
    ['marca','Marca',false,null],['modelo','Modelo',false,null],
    ['vin','VIN / Chasis',false,null],['correo','Correo electrónico',false,null],
    ['fecha','Fecha de ingreso',true,v=>parseDateFlexible(v)!=null],
    ['km','Kilometraje',true,v=>parseKm(v)!=null]
  ];
  const FIELD_LABELS_VEN = [
    ['cliente','Cliente',false,null],['telefono','Teléfono',false,null],['placa','Placa',true,isFilled],
    ['marca','Marca',false,null],['modelo','Modelo',false,null],
    ['vin','VIN / Chasis',false,null],['correo','Correo electrónico',false,null],
    ['fecha_venta','Fecha de venta',true,v=>parseDateFlexible(v)!=null]
  ];

  // ---------- generic dataset controller ----------
  function makeDataset(opts){
    const state = { headers:[], rows:[], map:{}, records:[], sheetNames:[], wb:null };
    const els = opts.els;

    function showDiag(html){
      els.diagBox.innerHTML = html;
      els.diagBox.hidden = false;
    }
    function clearDiag(){ els.diagBox.hidden = true; els.diagBox.innerHTML = ''; }

    els.fileInput.addEventListener('change', e=>{
      const f = e.target.files[0]; if(!f) return;
      clearDiag();
      els.confirmMsg.textContent = ''; els.confirmMsg.classList.remove('err');
      els.status.textContent = 'Leyendo ' + f.name + '…';
      const reader = new FileReader();
      reader.onload = ev=>{
        try{
          const data = new Uint8Array(ev.target.result);
          const wb = XLSX.read(data,{type:'array', cellDates:true});
          state.wb = wb; state.sheetNames = wb.SheetNames;
          if(wb.SheetNames.length>1){
            els.sheetPick.hidden=false;
            els.sheetSelect.innerHTML = wb.SheetNames.map(n=>`<option value="${cleanStr(n)}">${cleanStr(n)}</option>`).join('');
          } else { els.sheetPick.hidden=true; }
          els.headerRowPick.hidden = false;
          els.headerRowHint.hidden = false;
          els.headerRowInput.value = 1;
          loadSheet(wb.SheetNames[0]);
          els.status.textContent = f.name + ' — ' + wb.SheetNames.length + (wb.SheetNames.length===1?' hoja':' hojas');
        }catch(err){
          els.status.textContent = 'No se pudo leer el archivo (' + err.message + ')';
        }
      };
      reader.readAsArrayBuffer(f);
    });
    els.sheetSelect.addEventListener('change', e=> loadSheet(e.target.value));
    els.headerRowInput.addEventListener('change', ()=>{ if(state.currentSheet) loadSheet(state.currentSheet); });

    function loadSheet(name){
      state.currentSheet = name;
      const ws = state.wb.Sheets[name];
      const json = XLSX.utils.sheet_to_json(ws,{header:1, raw:true, defval:''});
      if(!json.length) return;
      const headerIdx = Math.max(1, parseInt(els.headerRowInput.value,10) || 1) - 1;
      if(headerIdx >= json.length){
        showDiag(`<strong>La fila de encabezados (${headerIdx+1}) está más allá del final de la hoja</strong>, que solo tiene ${json.length} fila(s). Ajuste el número.`);
        state.headers = []; state.rows = [];
        renderPreview(); renderMapping();
        els.mapGrid.hidden=false; els.actions.hidden=false;
        return;
      }
      clearDiag();
      state.headers = json[headerIdx].map(h=>String(h||'').trim()).filter(h=>h!=='');
      const headerRow = json[headerIdx];
      state.rows = json.slice(headerIdx+1).map(r=>{
        const obj={};
        headerRow.forEach((h,i)=>{ if(h) obj[String(h).trim()] = r[i]; });
        return obj;
      }).filter(r=>Object.values(r).some(v=>v!==''&&v!=null));
      renderPreview(); renderMapping();
      els.mapGrid.hidden=false; els.actions.hidden=false; els.confirmMsg.textContent=''; els.confirmMsg.classList.remove('err');
    }

    function renderPreview(){
      const headers = state.headers, rows = state.rows.slice(0,5);
      const c = x=>cleanStr(String(x));
      let html = '<thead><tr>' + headers.map(h=>`<th>${c(h)}</th>`).join('') + '</tr></thead><tbody>';
      rows.forEach(r=>{ html += '<tr>' + headers.map(h=>`<td>${r[h]!=null?c(r[h]):''}</td>`).join('') + '</tr>'; });
      html += '</tbody>';
      els.previewTable.innerHTML = html;
      els.previewWrap.hidden = false;
    }

    function renderMapping(){
      const headers = state.headers;
      let html='';
      opts.fields.forEach(([key,label,required])=>{
        const guess = guessHeader(headers, GUESS[key]||[]);
        const opts_ = ['<option value="">— Ninguno —</option>'].concat(
          headers.map(h=>`<option value="${cleanStr(String(h))}" ${h===guess?'selected':''}>${cleanStr(String(h))}</option>`)
        ).join('');
        html += `<div class="mapfield"><label>${label} ${required?'<span class="req">*</span>':''}</label><select data-key="${key}">${opts_}</select></div>`;
      });
      els.mapGrid.innerHTML = html;
    }

    els.processBtn.addEventListener('click', ()=>{
      clearDiag();
      const selects = els.mapGrid.querySelectorAll('select');
      const map = {}; selects.forEach(s=> map[s.dataset.key] = s.value);
      state.map = map;

      const missing = opts.fields.filter(([key,,required])=> required && !map[key]);
      if(missing.length){
        els.confirmMsg.textContent = 'Falta mapear ' + missing.length + ' campo(s) obligatorio(s).';
        els.confirmMsg.classList.add('err');
        showDiag(`<strong>No se puede confirmar el mapeo.</strong> Seleccione una columna para:
          <ul>${missing.map(([,label])=>`<li>${label}</li>`).join('')}</ul>
          Elija la columna correspondiente de su archivo en el desplegable de cada campo antes de confirmar.`);
        return;
      }
      if(!state.rows.length){
        els.confirmMsg.textContent = 'No hay filas de datos para procesar.';
        els.confirmMsg.classList.add('err');
        showDiag(`<strong>La hoja no tiene filas de datos</strong> después de la fila de encabezados indicada. Revise que eligió la hoja y la fila de encabezados correctas.`);
        return;
      }

      let skipped = 0;
      const records = [];
      state.rows.forEach(r=>{
        const rec = opts.buildRecord(r, map);
        if(rec) records.push(deepClean(rec)); else skipped++;
      });
      state.records = records;

      if(records.length === 0){
        els.confirmMsg.textContent = `0 de ${state.rows.length} fila(s) procesada(s).`;
        els.confirmMsg.classList.add('err');
        const problems = opts.fields.filter(([,,required,validator])=> required && validator).map(([key,label,,validator])=>{
          const col = map[key];
          const bad = state.rows.filter(r=> !validator(r[col]));
          const example = bad.length ? bad[0][col] : null;
          return {label, col, badCount:bad.length, example};
        }).filter(p=>p.badCount>0);
        let html = `<strong>Se leyeron ${state.rows.length} fila(s) pero ninguna quedó válida.</strong>`;
        if(problems.length){
          html += `<ul>${problems.map(p=>
            `<li><strong>${p.label}</strong> (columna <code>${p.col}</code>): ${p.badCount} de ${state.rows.length} fila(s) sin un valor reconocible`+
            (p.example!=null && p.example!=='' ? ` — ejemplo leído: <code>${String(p.example)}</code>` : ' — la celda está vacía')+
            `</li>`
          ).join('')}</ul>
          <p style="margin:8px 0 0;">Revise que el desplegable de cada campo apunte a la columna correcta y que la <strong>fila de encabezados</strong> (arriba) sea la que realmente contiene los títulos de columna.</p>`;
        } else {
          html += ` <p style="margin:8px 0 0;">Revise el mapeo de columnas y la fila de encabezados seleccionada.</p>`;
        }
        showDiag(html);
        return;
      }

      els.confirmMsg.classList.remove('err');
      els.confirmMsg.textContent = `${records.length} registro(s) procesado(s)` + (skipped? `, ${skipped} omitido(s) por datos incompletos.`:'.');
      opts.onProcessed(records);
    });

    return state;
  }

  const dsIngresos = makeDataset({
    els:{
      fileInput:document.getElementById('fileIngresos'), status:document.getElementById('statusIngresos'),
      sheetPick:document.getElementById('sheetPickIngresos'), sheetSelect:document.getElementById('sheetSelectIngresos'),
      headerRowPick:document.getElementById('headerRowPickIngresos'), headerRowInput:document.getElementById('headerRowIngresos'),
      headerRowHint:document.getElementById('headerRowHintIngresos'), diagBox:document.getElementById('diagIngresos'),
      previewWrap:document.getElementById('previewWrapIngresos'), previewTable:document.getElementById('previewTableIngresos'),
      mapGrid:document.getElementById('mapGridIngresos'), actions:document.getElementById('actionsIngresos'),
      processBtn:document.getElementById('btnProcessIngresos'), confirmMsg:document.getElementById('confirmIngresos')
    },
    fields: FIELD_LABELS_ING,
    buildRecord(r,map){
      const cliente = map.cliente ? r[map.cliente] : '';
      const placa = map.placa ? String(r[map.placa]||'').trim().toUpperCase() : '';
      const fecha = map.fecha ? parseDateFlexible(r[map.fecha]) : null;
      const km = map.km ? parseKm(r[map.km]) : null;
      if(!placa || !fecha || km==null) return null;
      return {
        cliente: cliente ? String(cliente).trim() : '(Sin nombre)',
        telefono: map.telefono ? String(r[map.telefono]||'').trim() : '',
        placa, marca: map.marca ? String(r[map.marca]||'').trim() : '',
        modelo: map.modelo ? String(r[map.modelo]||'').trim() : '',
        vin: map.vin ? String(r[map.vin]||'').trim().toUpperCase() : '',
        correo: map.correo ? String(r[map.correo]||'').trim() : '',
        fecha, km
      };
    },
    onProcessed(){ rebuildVehicles(); guardarBaseCompartida('ing'); }
  });

  const dsVentas = makeDataset({
    els:{
      fileInput:document.getElementById('fileVentas'), status:document.getElementById('statusVentas'),
      sheetPick:document.getElementById('sheetPickVentas'), sheetSelect:document.getElementById('sheetSelectVentas'),
      headerRowPick:document.getElementById('headerRowPickVentas'), headerRowInput:document.getElementById('headerRowVentas'),
      headerRowHint:document.getElementById('headerRowHintVentas'), diagBox:document.getElementById('diagVentas'),
      previewWrap:document.getElementById('previewWrapVentas'), previewTable:document.getElementById('previewTableVentas'),
      mapGrid:document.getElementById('mapGridVentas'), actions:document.getElementById('actionsVentas'),
      processBtn:document.getElementById('btnProcessVentas'), confirmMsg:document.getElementById('confirmVentas')
    },
    fields: FIELD_LABELS_VEN,
    buildRecord(r,map){
      const placa = map.placa ? String(r[map.placa]||'').trim().toUpperCase() : '';
      const fecha_venta = map.fecha_venta ? parseDateFlexible(r[map.fecha_venta]) : null;
      if(!placa || !fecha_venta) return null;
      return {
        cliente: map.cliente ? String(r[map.cliente]||'').trim() : '',
        telefono: map.telefono ? String(r[map.telefono]||'').trim() : '',
        placa, marca: map.marca ? String(r[map.marca]||'').trim() : '',
        modelo: map.modelo ? String(r[map.modelo]||'').trim() : '',
        vin: map.vin ? String(r[map.vin]||'').trim().toUpperCase() : '',
        correo: map.correo ? String(r[map.correo]||'').trim() : '',
        fecha_venta
      };
    },
    onProcessed(){ rebuildVehicles(); guardarBaseCompartida('ven'); }
  });

  // ---------- sample data ----------
  function daysAgo(n){ const d=new Date(); d.setDate(d.getDate()-n); return d; }
  function generateSample(){
    const names = ['Marcela Ortega','Diego Fernando Rosero','Luz Elena Guerrero','Carlos Andrés Bastidas','Paola Riascos','Jhon Jairo Erazo','Sandra Milena Cabrera','Édgar Portilla','Ana Lucía Benavides','Wilmer Chamorro','Claudia Patricia Zambrano','Iván Darío Muñoz'];
    const vehiculos = [
