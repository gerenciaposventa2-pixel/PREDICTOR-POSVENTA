  // ---------- vehicle index & analysis ----------
  let vehicles = []; // built from real data once processed
  let usingSample = true;

  function rebuildVehicles(){
    const ingresos = dsIngresos.records, ventas = dsVentas.records;
    if(!ingresos.length && !ventas.length) return;
    usingSample = false;
    document.getElementById('sampleBanner').hidden = true;
    const byPlaca = new Map();
    ingresos.forEach(r=>{
      if(!byPlaca.has(r.placa)) byPlaca.set(r.placa, {cliente:r.cliente, telefono:r.telefono, placa:r.placa, marca:r.marca, modelo:r.modelo, vin:r.vin||'', correo:r.correo||'', ingresos:[], venta:null});
      const v = byPlaca.get(r.placa);
      v.ingresos.push({fecha:r.fecha, km:r.km});
      if(r.cliente && r.cliente!=='(Sin nombre)') v.cliente = r.cliente;
      if(r.telefono) v.telefono = r.telefono;
      if(r.marca) v.marca = r.marca;
      if(r.modelo) v.modelo = r.modelo;
      if(r.vin) v.vin = r.vin;
      if(r.correo) v.correo = r.correo;
    });
    ventas.forEach(r=>{
      if(!byPlaca.has(r.placa)) byPlaca.set(r.placa, {cliente:r.cliente||'(Sin nombre)', telefono:r.telefono, placa:r.placa, marca:r.marca, modelo:r.modelo, vin:r.vin||'', correo:r.correo||'', ingresos:[], venta:null});
