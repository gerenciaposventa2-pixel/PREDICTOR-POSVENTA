<title>Predictor Posventa</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
:root{
  --bg:#eef1f3; --surface:#ffffff; --surface-2:#f4f6f8; --border:#d7dee4;
  --text:#172029; --text-muted:#5c6b78;
  --accent:#0f7b8a; --accent-strong:#0b616d; --accent-soft:#e3f2f3;
  --ok:#1f8a4c; --ok-soft:#e4f6ea;
  --warn:#b9760f; --warn-soft:#fbf0dc;
  --critical:#c0392b; --critical-soft:#fbe6e2;
  --neutral-status:#6a6f8c; --neutral-status-soft:#e9e9f3;
  --shadow:0 1px 2px rgba(23,32,41,.07), 0 4px 14px rgba(23,32,41,.07);
  --radius:10px;
  --font-display:'IBM Plex Sans',system-ui,sans-serif;
  --font-body:'IBM Plex Sans',system-ui,sans-serif;
  --font-mono:'IBM Plex Mono',ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#11161c; --surface:#171e26; --surface-2:#1d2530; --border:#2b3542;
    --text:#e7edf2; --text-muted:#93a3b0;
    --accent:#38b7c4; --accent-strong:#5fd0dc; --accent-soft:#173038;
    --ok:#4bbd77; --ok-soft:#173a27;
    --warn:#e0a940; --warn-soft:#3a2f14;
    --critical:#e2695a; --critical-soft:#3a1e19;
    --neutral-status:#9ba0c9; --neutral-status-soft:#252a3d;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 26px rgba(0,0,0,.35);
  }
}
:root[data-theme="dark"]{
  --bg:#11161c; --surface:#171e26; --surface-2:#1d2530; --border:#2b3542;
  --text:#e7edf2; --text-muted:#93a3b0;
  --accent:#38b7c4; --accent-strong:#5fd0dc; --accent-soft:#173038;
  --ok:#4bbd77; --ok-soft:#173a27;
  --warn:#e0a940; --warn-soft:#3a2f14;
  --critical:#e2695a; --critical-soft:#3a1e19;
  --neutral-status:#9ba0c9; --neutral-status-soft:#252a3d;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 26px rgba(0,0,0,.35);
}
*{box-sizing:border-box;}
@media (prefers-reduced-motion: reduce){ *{transition:none!important; animation:none!important;} }
body{background:var(--bg); color:var(--text); font-family:var(--font-body); line-height:1.45;}
h1,h2,h3{font-family:var(--font-display); text-wrap:balance; margin:0;}
.wrap{max-width:1180px; margin:0 auto; padding:28px 20px 80px;}
.tabular{font-variant-numeric:tabular-nums;}
.mono{font-family:var(--font-mono);}

/* header */
.topbar{position:sticky; top:0; z-index:20; background:color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter:blur(6px); border-bottom:1px solid var(--border);}
.topbar-inner{max-width:1180px; margin:0 auto; padding:12px 20px; display:flex; align-items:center; gap:18px; flex-wrap:wrap;}
.brand{display:flex; align-items:center; gap:10px; margin-right:auto;}
.brand-mark{width:30px; height:30px; border-radius:8px; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:600; font-size:13px; flex:none;}
.brand-name{font-weight:600; font-size:15px;}
.brand-sub{font-size:12px; color:var(--text-muted);}
.session-info{display:flex; align-items:center; gap:10px; font-size:12.5px; color:var(--text-muted);}
.session-info strong{color:var(--text);}
.overlay .login-box{max-width:380px;}
.login-box h3{font-size:16px; margin-bottom:4px;}
.role-perm-card{border:1px solid var(--border); border-radius:8px; padding:10px 14px; background:var(--surface); margin-bottom:8px;}
.role-perm-name{font-weight:600; font-size:13px; margin-bottom:8px;}
.role-perm-chips{display:flex; flex-wrap:wrap; gap:6px 14px;}
.perm-chip{display:inline-flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-muted); cursor:pointer; user-select:none;}
.perm-chip input{margin:0;}
.perm-chip-tipifica{border-left:2px solid var(--accent); padding-left:10px; margin-left:4px; color:var(--text);}
.hero{padding:26px 0 6px;}

/* fichero: pestañas de carpeta que controlan qué módulo se muestra */
.filetabs{display:flex; gap:3px; margin-top:22px; overflow-x:auto; scrollbar-width:thin;}
.filetab{flex:none; font-family:var(--font-body); font-size:12.5px; font-weight:600; padding:10px 16px; border:1px solid var(--border); border-radius:10px 10px 0 0; background:var(--surface-2); color:var(--text-muted); cursor:pointer; white-space:nowrap;}
.filetab:hover{color:var(--text);}
.filetab[aria-selected="true"]{background:var(--surface); color:var(--text); border-bottom-color:var(--surface); box-shadow:0 -1px 0 var(--surface);}
.tabpanel{margin-top:0!important; border-top-left-radius:0;}
.hero h1{font-size:26px; letter-spacing:-.01em;}
.hero p{margin:8px 0 0; color:var(--text-muted); max-width:66ch; font-size:14.5px;}

.banner{margin-top:18px; display:flex; align-items:flex-start; gap:10px; background:var(--accent-soft); border:1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); color:var(--text); border-radius:var(--radius); padding:12px 14px; font-size:13.5px;}
.banner strong{color:var(--accent-strong);}
.banner button{margin-left:auto; flex:none; background:none; border:1px solid var(--border); border-radius:6px; padding:4px 9px; font-size:12px; color:var(--text-muted); cursor:pointer;}
.global-storage-banner{display:flex; align-items:flex-start; gap:10px; background:var(--warn-soft); border-bottom:1px solid var(--warn); color:var(--text); padding:10px 18px; font-size:13px;}
.global-storage-banner strong{color:var(--warn);}

/* cards */
.card{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow); padding:22px 24px; margin-top:20px;}
.card-head{display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin-bottom:4px;}
.step-num{font-family:var(--font-mono); font-size:12px; color:var(--accent); background:var(--accent-soft); border-radius:5px; padding:2px 7px; font-weight:600;}
.card h2{font-size:17px;}
.card .optional{font-size:12px; color:var(--text-muted); font-weight:400;}
.card > p.hint{margin:6px 0 16px; color:var(--text-muted); font-size:13.5px; max-width:70ch;}

/* file drop */
.filerow{display:flex; align-items:center; gap:12px; flex-wrap:wrap;}
.filebtn{display:inline-flex; align-items:center; gap:8px; background:var(--surface-2); border:1px dashed var(--border); border-radius:8px; padding:10px 16px; cursor:pointer; font-size:13.5px; color:var(--text);}
.filebtn:hover{border-color:var(--accent);}
.filebtn input{display:none;}
.filestatus{font-size:12.5px; color:var(--text-muted);}
select, .txtinput{font-family:var(--font-body); font-size:13.5px; padding:7px 10px; border-radius:7px; border:1px solid var(--border); background:var(--surface); color:var(--text);}
select:focus, .txtinput:focus, button:focus-visible, .pill:focus-visible{outline:2px solid var(--accent); outline-offset:1px;}

.sheetpick{display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-muted);}

.preview-wrap{overflow-x:auto; margin-top:14px; border:1px solid var(--border); border-radius:8px;}
table.preview{border-collapse:collapse; width:100%; font-size:12.5px; white-space:nowrap;}
table.preview th{background:var(--surface-2); text-align:left; padding:7px 10px; font-weight:600; color:var(--text-muted); border-bottom:1px solid var(--border);}
table.preview td{padding:6px 10px; border-bottom:1px solid var(--border); color:var(--text);}

.mapgrid{display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px 16px; margin-top:16px;}
.mapfield label{display:block; font-size:12px; color:var(--text-muted); margin-bottom:5px;}
.mapfield label .req{color:var(--critical);}
.mapfield select{width:100%;}

.btn{font-family:var(--font-body); font-size:13.5px; font-weight:600; padding:9px 18px; border-radius:8px; border:1px solid transparent; cursor:pointer;}
.btn-primary{background:var(--accent); color:#fff;}
.btn-primary:hover{background:var(--accent-strong);}
.btn-ghost{background:var(--surface-2); color:var(--text); border-color:var(--border);}
.btn-ghost:hover{border-color:var(--accent);}
.btn:disabled{opacity:.5; cursor:not-allowed;}
.actionsrow{display:flex; align-items:center; gap:12px; margin-top:18px; flex-wrap:wrap;}
.confirmmsg{font-size:12.5px; color:var(--ok);}
.confirmmsg.err{color:var(--critical);}
.diagbox{margin-top:14px; border:1px solid var(--critical); background:var(--critical-soft); border-radius:8px; padding:12px 14px; font-size:12.5px; color:var(--text);}
.diagbox strong{color:var(--critical);}
.diagbox ul{margin:8px 0 0; padding-left:18px;}
.diagbox li{margin:3px 0;}
.diagbox code{font-family:var(--font-mono); background:var(--surface); padding:1px 5px; border-radius:4px; border:1px solid var(--border);}

/* config */
.cfggrid{display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:16px 20px;}
.cfgfield label{display:block; font-size:12.5px; color:var(--text-muted); margin-bottom:6px;}
.cfgfield .num{display:flex; align-items:center; gap:8px;}
.cfgfield input[type=number]{width:90px; font-family:var(--font-mono); font-size:14px; padding:7px 9px; border-radius:7px; border:1px solid var(--border); background:var(--surface); color:var(--text);}
.cfgfield .unit{font-size:12.5px; color:var(--text-muted);}
.radiorow{display:flex; flex-direction:column; gap:6px; font-size:13px;}
.radiorow label{display:flex; align-items:center; gap:7px; font-weight:400; color:var(--text);}

/* config de agenda */
.agenda-config-grid{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:6px;}
@media (max-width:640px){ .agenda-config-grid{grid-template-columns:1fr;} }
.agenda-catalog{border:1px solid var(--border); border-radius:var(--radius); background:var(--surface-2); padding:16px;}
.agenda-catalog h3{font-size:13.5px; margin:0 0 10px;}
.agenda-add-row{display:flex; gap:8px;}
.agenda-add-row input{flex:1;}
.agenda-chips{display:flex; flex-wrap:wrap; gap:8px; margin-top:12px;}
.agenda-chip{display:inline-flex; align-items:center; gap:7px; font-size:12.5px; padding:5px 6px 5px 12px; border-radius:20px; background:var(--surface); border:1px solid var(--border); color:var(--text);}
.agenda-chip button{width:18px; height:18px; border-radius:50%; border:none; background:var(--critical-soft); color:var(--critical); font-size:12px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center;}
.sem-nav{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px; font-size:14px;}
.sem-nav strong{min-width:260px; text-align:center;}
.sem-actions{display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:12px; padding:10px 12px; background:var(--surface-2); border:1px solid var(--border); border-radius:8px; font-size:12.5px; color:var(--text-muted);}
.sem-copy{display:inline-flex; align-items:center; gap:6px;}
.sem-actions input[type=number]{width:58px; padding:4px 6px;}
.sem-table{border-collapse:collapse; width:100%; font-size:13px; min-width:720px;}
.sem-table thead th{text-align:left; padding:9px 10px; font-size:11.5px; text-transform:uppercase; letter-spacing:.04em; font-weight:600; color:var(--text-muted); background:var(--surface-2); border-bottom:1px solid var(--border); white-space:nowrap;}
.sem-table td{padding:6px 10px; border-bottom:1px solid var(--border); vertical-align:middle; white-space:nowrap; background:var(--surface);}
.sem-table tbody tr:last-child td{border-bottom:none;}
.sem-table tr.sem-finde td{background:var(--surface-2);}
.sem-table td.sem-day{min-width:150px;}
.sem-table td.sem-day .perm-chip{color:var(--text); font-size:13px;}
.sem-table tr.sem-off td{color:var(--text-muted);}
.sem-table select{width:100%; min-width:88px; padding:5px 8px; font-size:12.5px;}
.form-sec{margin-top:22px; padding-top:18px; border-top:1px solid var(--border);}
.form-sec.first{margin-top:10px; padding-top:0; border-top:none;}
.form-sec-title{display:flex; align-items:center; gap:9px; font-size:14px; font-weight:700; margin-bottom:6px;}
.form-sec-title .n{display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:var(--accent-soft); color:var(--accent-strong); font-size:12px; font-weight:700;}
.form-sec-hint{font-size:12.5px; color:var(--text-muted); margin:0 0 12px; max-width:85ch;}
.asesor-form-grid5{display:grid; grid-template-columns:repeat(5,1fr); gap:12px;}
@media (max-width:900px){ .asesor-form-grid5{grid-template-columns:1fr 1fr;} }
@media (max-width:560px){ .asesor-form-grid5{grid-template-columns:1fr;} }
.franja-card{border:1px solid var(--border); border-radius:8px; padding:12px 14px; background:var(--surface); margin-bottom:10px;}
.franja-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:12.5px; font-weight:600;}
.franja-dias{display:flex; flex-wrap:wrap; gap:6px 12px; margin:6px 0 10px;}
.agenda-chip button[data-taller-ciudad]{background:var(--accent-soft); color:var(--accent-strong); font-size:10.5px;}
.agenda-empty{font-size:12.5px; color:var(--text-muted);}

.asesor-form-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px;}
.asesor-form-grid3{display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; margin:14px 0;}
@media (max-width:640px){ .asesor-form-grid, .asesor-form-grid3{grid-template-columns:1fr;} }
.cal-widget{border:1px solid var(--border); border-radius:8px; padding:12px; background:var(--surface-2); max-width:320px;}
.cal-nav{display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; font-size:13px; font-weight:600;}
.cal-nav button{width:26px; height:26px; border-radius:6px; border:1px solid var(--border); background:var(--surface); color:var(--text); cursor:pointer; font-size:14px; line-height:1;}
.cal-nav button:hover{border-color:var(--accent);}
.cal-grid-header{display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-bottom:4px;}
.cal-dow{text-align:center; font-size:10.5px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.03em;}
.cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:4px; user-select:none;}
.cal-day{aspect-ratio:1; border:1px solid var(--border); border-radius:6px; background:var(--surface); font-family:var(--font-mono); font-size:12px; cursor:pointer; color:var(--text); padding:0; touch-action:none;}
.cal-day:hover{border-color:var(--accent);}
.cal-day.dim{color:var(--text-muted); opacity:.45;}
.cal-day.active{background:var(--accent); border-color:var(--accent); color:#fff; font-weight:600;}
.cal-day.active.dim{opacity:.75;}

.carga-grid{display:grid; grid-template-columns:1fr 1fr; gap:8px 14px; margin-top:6px;}
@media (max-width:640px){ .carga-grid{grid-template-columns:1fr;} }
.carga-row{display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:12.5px; border:1px solid var(--border); border-radius:7px; padding:7px 10px; background:var(--surface);}
.carga-row input{width:52px; font-family:var(--font-mono); font-size:13px; padding:5px 6px; border-radius:6px; border:1px solid var(--border); background:var(--surface-2); color:var(--text); text-align:center;}
.carga-row input.over-limit{border-color:var(--critical); background:var(--critical-soft); color:var(--critical);}
.carga-pool-indicator{margin:8px 0 14px; padding:14px 16px; border:1px solid var(--border); border-radius:8px; background:var(--surface-2);}
.carga-donut-wrap{display:flex; align-items:center; gap:20px; flex-wrap:wrap;}
.carga-donut-svg{flex:none;}
.carga-legend{display:flex; flex-direction:column; gap:6px; font-size:12.5px; color:var(--text);}
.carga-legend-item{display:flex; align-items:center; gap:8px;}
.carga-legend-item i{width:10px; height:10px; border-radius:3px; flex:none;}

.asesor-preview{margin-top:14px; padding:12px 14px; border:1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); background:var(--accent-soft); border-radius:8px;}
.asesor-preview-title{font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--accent-strong); font-weight:700; margin-bottom:10px;}
.asesor-preview-body{display:flex; gap:18px; align-items:flex-start; flex-wrap:wrap;}
.asesor-preview-donut{flex:none;}
.asesor-preview-info{flex:1; min-width:220px;}
.asesor-preview-summary{display:flex; gap:18px; flex-wrap:wrap; font-size:13px; margin-bottom:10px;}
.asesor-preview-summary strong{font-family:var(--font-mono); font-size:15px;}
.asesor-preview-tipos{display:flex; flex-wrap:wrap; gap:6px; margin-top:10px;}
.asesor-preview-tipo{font-size:11px; padding:3px 9px; border-radius:20px; background:var(--surface); border:1px solid var(--border); color:var(--text-muted);}

.slot-strip{display:flex; flex-wrap:wrap; gap:3px;}
.slot-chip{width:13px; height:13px; border-radius:3px; background:var(--ok); flex:none;}
.slot-chip.taken{background:var(--critical);}
.slot-chip.lunch{background:var(--border);}
.slot-strip-legend{display:flex; gap:14px; margin-top:8px; font-size:11px; color:var(--text-muted);}
.slot-strip-legend i{display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:5px; vertical-align:middle;}
.slot-strip-legend i.ok{background:var(--ok);}
.slot-strip-legend i.taken{background:var(--critical);}
.slot-strip-legend i.lunch{background:var(--border);}

.asesor-list{display:flex; flex-direction:column; gap:10px; margin-top:16px;}
.asesor-card{display:flex; align-items:center; gap:14px; flex-wrap:wrap; border:1px solid var(--border); border-radius:8px; background:var(--surface); padding:10px 14px;}
.asesor-card .ac-name{font-weight:600; font-size:13.5px;}
.asesor-card .ac-taller{font-size:12px; color:var(--accent-strong); background:var(--accent-soft); padding:2px 9px; border-radius:20px;}
.asesor-card .ac-detail{font-size:12px; color:var(--text-muted);}
.asesor-card .ac-actions{margin-left:auto; display:flex; gap:8px;}
.asesor-card .ac-actions button{font-size:12px; background:none; border:none; color:var(--text-muted); text-decoration:underline; cursor:pointer; padding:0;}
.asesor-card .ac-actions button.danger{color:var(--critical);}

.disponibilidad-controls{display:flex; gap:16px; flex-wrap:wrap; margin-top:14px;}
.disponibilidad-controls select, .disponibilidad-controls input{font-family:var(--font-body); font-size:13.5px; padding:7px 10px; border-radius:7px; border:1px solid var(--border); background:var(--surface); color:var(--text);}

.slot-picks{display:flex; flex-wrap:wrap; gap:6px; margin-top:8px;}
.slot-pick{font-size:11.5px; padding:4px 9px; border-radius:6px; border:1px solid var(--border); background:var(--surface); cursor:pointer; font-family:var(--font-mono);}
.slot-pick:hover{border-color:var(--accent);}
.slot-pick.taken{color:var(--text-muted); text-decoration:line-through; cursor:not-allowed; background:var(--surface-2);}
.slot-pick.chosen{background:var(--accent); border-color:var(--accent); color:#fff;}
.slot-note{font-size:11.5px; color:var(--text-muted); margin-top:6px;}
.slot-note.alert{color:var(--critical); font-weight:600; background:var(--critical-soft); border:1px solid color-mix(in srgb, var(--critical) 40%, var(--border)); border-radius:6px; padding:6px 9px; margin-top:8px;}

/* results */
.statgrid{display:grid; grid-template-columns:repeat(auto-fit,minmax(112px,1fr)); gap:12px; margin-top:6px;}
.stat{border:1px solid var(--border); border-top:3px solid var(--accent); border-radius:8px; padding:12px 14px; background:var(--surface-2);}
.stat.ok{border-top-color:var(--ok);} .stat.warn{border-top-color:var(--warn);} .stat.critical{border-top-color:var(--critical);} .stat.neutral{border-top-color:var(--neutral-status);}
.stat .num{font-family:var(--font-mono); font-size:24px; font-weight:600; line-height:1;}
.stat .lbl{font-size:12px; color:var(--text-muted); margin-top:5px;}

.stackbar{display:flex; height:10px; border-radius:6px; overflow:hidden; margin-top:16px; border:1px solid var(--border);}
.stackbar span{height:100%;}
.legend{display:flex; gap:16px; margin-top:8px; flex-wrap:wrap; font-size:12px; color:var(--text-muted);}
.legend i{display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:5px; vertical-align:middle;}

.marca-picker{display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-top:16px; padding:12px 16px; background:var(--accent-soft); border:1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); border-radius:var(--radius);}
.marca-picker label{font-size:12.5px; font-weight:700; color:var(--accent-strong); text-transform:uppercase; letter-spacing:.03em;}
.marca-picker select{font-family:var(--font-body); font-size:14px; font-weight:600; padding:8px 14px; border-radius:8px; border:1px solid var(--accent); background:var(--surface); color:var(--text); min-width:180px;}
.marca-picker-hint{font-size:12px; color:var(--text-muted);}
@media (max-width:560px){ .marca-picker{align-items:flex-start; flex-direction:column;} }

