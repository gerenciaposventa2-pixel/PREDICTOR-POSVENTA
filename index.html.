        wk[dow] = normalizeDia({ horaInicio:t.horaInicio, horaFin:t.horaFin, intervaloMin:t.intervaloMin, almuerzoInicio:t.almuerzoInicio||'', almuerzoFin:t.almuerzoFin||'' });
      } else delete wk[dow];
      setSemana(formWeekMonday, wk); planChanged(); return;
