  // hora fin y almuerzo deben caer en un bloque exacto de la periodicidad, contado desde la hora de
  // inicio (que es el punto de referencia de la agenda) — no minuto a minuto libre.
  // Hora inicio / Hora fin / Almuerzo son <select> cuyas opciones se generan a partir de la
  // periodicidad — así solo se puede elegir un bloque exacto, nunca un minuto libre.
  function buildDayTimeOptions(stepMin){
    const opts = [];
    for(let t=0; t<24*60; t+=stepMin) opts.push(String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'));
    return opts;
  }
  function buildAfterTimeOptions(anchorStr, stepMin, beforeStr){
    const toMin = t=>{ const [h,m]=t.split(':').map(Number); return h*60+m; };
    const anchor = toMin(anchorStr||'00:00');
    const limit = beforeStr ? toMin(beforeStr) : (24*60-1);
    const opts = [];
    for(let t=anchor+stepMin; t<=limit; t+=stepMin) opts.push(String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'));
    return opts;
  }
  function fillTimeSelect(selId, options, includeBlank){
