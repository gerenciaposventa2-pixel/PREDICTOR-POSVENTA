  function renderDonut(){
    const base = marcaFilteredList();
    const total = base.length;
    let agendado=0, efectivo=0, noEfectivo=0;
    base.forEach(v=>{
      const g = gestionesMap.get(v.placa);
      if(g && g.categoria==='agendado') agendado++;
      else if(g && g.categoria==='efectivo') efectivo++;
      else if(g && g.categoria==='no_efectivo') noEfectivo++;
    });
    const sinGestion = total - agendado - efectivo - noEfectivo;
    const r=60, cx=80, cy=80, sw=18, circumference=2*Math.PI*r;
    const segments = [
      {value:sinGestion, color:'var(--neutral-status)'},
      {value:agendado, color:'var(--accent)'},
      {value:efectivo, color:'var(--ok)'},
      {value:noEfectivo, color:'var(--warn)'}
    ];
    let cumulative = 0, circles = '';
    if(total===0){
      circles = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--border)" stroke-width="${sw}"></circle>`;
    } else {
      segments.forEach(seg=>{
        if(seg.value<=0) return;
        const len = (seg.value/total)*circumference;
        circles += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:${seg.color}" stroke-width="${sw}" stroke-dasharray="${len} ${circumference-len}" stroke-dashoffset="${-cumulative}" transform="rotate(-90 ${cx} ${cy})"></circle>`;
        cumulative += len;
      });
    }
    document.getElementById('gestionDonut').innerHTML = circles;
    document.getElementById('donutCenter').innerHTML = `<div class="n tabular">${total}</div><div class="t">vehículo${total===1?'':'s'}</div>`;
    document.getElementById('donutLegend').innerHTML = `
      <span><i style="background:var(--neutral-status)"></i>Sin gestión (${sinGestion})</span>
      <span><i style="background:var(--accent)"></i>Agendado (${agendado})</span>
      <span><i style="background:var(--ok)"></i>Contacto efectivo (${efectivo})</span>
      <span><i style="background:var(--warn)"></i>Contacto no efectivo (${noEfectivo})</span>
    `;
    renderAgendadoBreakdown(base);
  }

  function renderAgendadoBreakdown(base){
    const counts = {};
    TIPIFICACIONES.filter(t=>t.categoria==='agendado').forEach(t=> counts[t.value]=0);
    base.forEach(v=>{
      const g = gestionesMap.get(v.placa);
      if(g && g.categoria==='agendado' && counts.hasOwnProperty(g.tipificacion)) counts[g.tipificacion]++;
    });
    const el = document.getElementById('agendadoBreakdown');
    const totalAgendados = Object.values(counts).reduce((a,b)=>a+b,0);
    const title = `<div class="agendado-breakdown-title">Agendados por tipo${totalAgendados?` (${totalAgendados})`:''}</div>`;
    const rows = TIPIFICACIONES.filter(t=>t.categoria==='agendado').map(t=>
      `<div class="arow"><span class="an">${t.label.replace('Agendado ','')}</span><span class="av tabular">${counts[t.value]}</span></div>`
    ).join('');
    el.innerHTML = title + rows;
  }

  function renderMarcaBreakdown(){
    const groups = new Map();
    analyzed.forEach(v=>{
      const m = v.marca || 'Sin marca';
      if(!groups.has(m)) groups.set(m, {total:0, agendado:0, efectivo:0, noEfectivo:0, sinGestion:0});
      const g = groups.get(m);
      g.total++;
      const ges = gestionesMap.get(v.placa);
      if(ges && ges.categoria==='agendado') g.agendado++;
      else if(ges && ges.categoria==='efectivo') g.efectivo++;
      else if(ges && ges.categoria==='no_efectivo') g.noEfectivo++;
      else g.sinGestion++;
    });
    const rows = Array.from(groups.entries()).sort((a,b)=>b[1].total-a[1].total);
    const el = document.getElementById('marcaBreakdown');
    if(!rows.length){ el.innerHTML = '<div class="empty">Sin datos.</div>'; return; }
    el.innerHTML = rows.map(([marca,g])=>{
      const pctGestionado = g.total ? Math.round((g.agendado+g.efectivo+g.noEfectivo)/g.total*100) : 0;
      const seg = (n,color)=> g.total? `<span style="width:${n/g.total*100}%; background:${color}"></span>` : '';
      return `<div class="marca-row">
        <div class="marca-row-head"><span class="marca-name">${marca}</span><span class="marca-count">${g.total} vehículo${g.total===1?'':'s'}</span></div>
