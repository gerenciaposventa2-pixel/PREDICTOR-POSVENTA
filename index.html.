  // la carga es un reparto: el total de espacios que tiene UN día completo con el horario configurado
  // (independiente de qué días estén marcados en el calendario) se distribuye entre los tipos de
  // agendamiento, así que la SUMA de todas las cargas nunca puede superar ese total — no cada una por
  // separado. Subir una le quita cupo disponible a las demás.
  // `changedInput`: el campo que el usuario acaba de editar (se recorta ese); si es null, cambió el
  // horario y se recorta desde el final de la lista hasta que la suma vuelva a calzar.
  function enforceCargaLimits(changedInput){
    const cuposPlantilla = getEffectiveCupos(readScheduleDraft());
    const inputs = Array.from(document.querySelectorAll('#nuevoAsesorCargaGrid input[data-carga]'));
    const warn = document.getElementById('cargaLimitWarning');
    let seAjusto = false;

    if(cuposPlantilla<=0){
      inputs.forEach(inp=>{ inp.removeAttribute('max'); inp.classList.remove('over-limit'); });
      warn.hidden = true;
      return {cuposPlantilla, total: inputs.reduce((s,i)=>s+Math.max(0,parseInt(i.value,10)||0),0)};
    }

    if(changedInput){
      const otros = inputs.filter(i=>i!==changedInput).reduce((s,i)=>s+Math.max(0,parseInt(i.value,10)||0),0);
      const disponibleParaEste = Math.max(0, cuposPlantilla - otros);
      const v = Math.max(0, parseInt(changedInput.value,10)||0);
      if(v>disponibleParaEste){ changedInput.value = disponibleParaEste; seAjusto = true; }
    } else {
      let total = inputs.reduce((s,i)=>s+Math.max(0,parseInt(i.value,10)||0),0);
      if(total>cuposPlantilla){
        seAjusto = true;
        let exceso = total - cuposPlantilla;
        for(let i=inputs.length-1; i>=0 && exceso>0; i--){
          const v = Math.max(0, parseInt(inputs[i].value,10)||0);
          const recorte = Math.min(v, exceso);
          inputs[i].value = v - recorte;
          exceso -= recorte;
        }
      }
    }

    const total = inputs.reduce((s,i)=>s+Math.max(0,parseInt(i.value,10)||0),0);
    inputs.forEach(inp=>{
      const otros = total - Math.max(0,parseInt(inp.value,10)||0);
      inp.max = String(Math.max(0, cuposPlantilla - otros));
      inp.classList.remove('over-limit');
    });

    if(seAjusto){
      warn.textContent = `Los ${cuposPlantilla} espacio(s) del día se reparten entre los tipos de agendamiento — se ajustó automáticamente para que la suma no los supere.`;
      warn.hidden = false;
    } else {
      warn.hidden = true;
    }
    return {cuposPlantilla, total};
  }
  // dona: proporción de la carga repartida entre los tipos de agendamiento (más lo aún sin asignar).
  const CARGA_PALETTE = ['#0f7b8a','#4f6bed','#9457eb','#e0578a','#e08a2f','#2f9e58','#c4432e','#6b6f8a'];
  function renderCargaDonut(cargaPorTipo, cuposPlantilla){
    const el = document.getElementById('cargaPoolIndicator');
    const tipos = TIPIFICACIONES.filter(t=>t.categoria==='agendado');
    const total = tipos.reduce((s,t)=> s + (cargaPorTipo[t.value]||0), 0);
    if(cuposPlantilla<=0){
      el.innerHTML = `<div class="agenda-empty">Defina un horario válido para ver el reparto.</div>`;
      return;
    }
    const r=40, cx=48, cy=48, sw=13, circunf=2*Math.PI*r;
    let cumulative=0, rings='';
    tipos.forEach((t,i)=>{
      const val = cargaPorTipo[t.value]||0;
      if(val<=0) return;
      const len = (val/cuposPlantilla)*circunf;
      rings += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:${CARGA_PALETTE[i%CARGA_PALETTE.length]}" stroke-width="${sw}" stroke-dasharray="${len} ${circunf-len}" stroke-dashoffset="${-cumulative}" transform="rotate(-90 ${cx} ${cy})"></circle>`;
      cumulative += len;
    });
    const sinAsignar = Math.max(0, cuposPlantilla-total);
    if(sinAsignar>0){
      const len = (sinAsignar/cuposPlantilla)*circunf;
      rings += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--border)" stroke-width="${sw}" stroke-dasharray="${len} ${circunf-len}" stroke-dashoffset="${-cumulative}" transform="rotate(-90 ${cx} ${cy})"></circle>`;
    }
    if(total===0) rings = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--border)" stroke-width="${sw}"></circle>`;

    const donutSvg = `<svg viewBox="0 0 96 96" width="84" height="84" role="img" aria-label="Reparto de carga por tipo de agendamiento">
      ${rings}
      <text x="48" y="45" text-anchor="middle" font-size="13" font-weight="700" style="fill:var(--text); font-family:var(--font-mono)">${total}/${cuposPlantilla}</text>
      <text x="48" y="58" text-anchor="middle" font-size="8.5" style="fill:var(--text-muted); font-family:var(--font-body)">repartido</text>
    </svg>`;

    const legend = tipos.map((t,i)=>{
      const val = cargaPorTipo[t.value]||0;
      if(val<=0) return '';
      const pct = Math.round(val/cuposPlantilla*100);
      return `<span class="carga-legend-item"><i style="background:${CARGA_PALETTE[i%CARGA_PALETTE.length]}"></i>${t.label.replace('Agendado ','')} · ${val} (${pct}%)</span>`;
    }).join('');
    const legendSinAsignar = sinAsignar>0
      ? `<span class="carga-legend-item"><i style="background:var(--border)"></i>Sin asignar · ${sinAsignar} (${Math.round(sinAsignar/cuposPlantilla*100)}%)</span>`
      : '';

    el.innerHTML = `<div class="carga-donut-wrap">
      <div class="carga-donut-svg">${donutSvg}</div>
      <div class="carga-legend">${legend}${legendSinAsignar}</div>
    </div>`;
  }

  // vista previa en vivo: cupos de hoy para este asesor, ocupados por citas ya agendadas y disponibles,
  // recalculada automáticamente con los valores que se van escribiendo en el formulario (horario, almuerzo,
  // días marcados en el calendario y carga por tipo de agendamiento).
  function renderAsesorFormPreview(){
    const el = document.getElementById('asesorFormPreview');
    const draft = { ...readScheduleDraft(), cargaPorTipo: getCargaFromGrid() };
    const cuposPlantilla = getEffectiveCupos(draft);
    renderCargaDonut(draft.cargaPorTipo, cuposPlantilla);
    const hoy = todayStr();
    const atiendeHoy = formFechas.includes(hoy);
