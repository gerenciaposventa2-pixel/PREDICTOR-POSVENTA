    if(diaHoy) Object.assign(draft, { horaInicio:diaHoy.horaInicio, horaFin:diaHoy.horaFin, intervaloMin:diaHoy.intervaloMin, almuerzoInicio:diaHoy.almuerzoInicio||null, almuerzoFin:diaHoy.almuerzoFin||null });
    const cupos = atiendeHoy ? getEffectiveCupos(draft) : 0;

    let ocupado = 0, citasHoy = 0;
    const porTipo = {};
    if(editingAsesorNombre){
      gestionesMap.forEach(g=>{
        if(ocupaAgenda(g) && g.asesorServicio===editingAsesorNombre && g.proximaGestion===hoy){
          citasHoy++;
          ocupado += getCarga(draft, g.tipificacion);
          porTipo[g.tipificacion] = (porTipo[g.tipificacion]||0)+1;
        }
      });
    }
    const disponible = Math.max(0, cupos - ocupado);
    const pct = cupos ? Math.round(ocupado/cupos*100) : (ocupado>0 ? 100 : 0);
    const barColor = pct>=100?'critical':pct>=70?'warn':'ok';

    if(!atiendeHoy){
      el.innerHTML = `<div class="asesor-preview-title">Disponibilidad de hoy</div>
        <div class="agenda-empty">Este asesor no tiene hoy habilitado en su calendario — marque el día de hoy en la agenda semanal para ver el cálculo.</div>`;
      return;
    }

    // dona: proporción ocupado/disponible
    const r=34, cx=40, cy=40, sw=10, circunf=2*Math.PI*r;
    let donutRings;
    if(cupos===0){
      donutRings = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--border)" stroke-width="${sw}"></circle>`;
    } else {
      const ocupLen = (ocupado/cupos)*circunf;
      donutRings = `
        <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--ok)" stroke-width="${sw}"></circle>
        ${ocupLen>0 ? `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--${barColor})" stroke-width="${sw}" stroke-dasharray="${ocupLen} ${circunf-ocupLen}" transform="rotate(-90 ${cx} ${cy})"></circle>` : ''}
      `;
    }
    const donutSvg = `<svg viewBox="0 0 80 80" width="72" height="72" role="img" aria-label="Ocupación de hoy">
      ${donutRings}
      <text x="40" y="45" text-anchor="middle" font-size="16" font-weight="700" style="fill:var(--text); font-family:var(--font-mono)">${pct}%</text>
    </svg>`;

    // franja de espacios del día: cada casilla es un turno (disponible / ocupado / almuerzo)
    const statuses = computeSlotStatusesForPreview(draft, hoy, editingAsesorNombre);
    const stripHtml = statuses.length ? `<div class="slot-strip">${statuses.map(s=>
      `<span class="slot-chip ${s.status}" title="${s.time} · ${s.status==='lunch'?'Almuerzo':s.status==='taken'?'Ocupado':'Disponible'}"></span>`
    ).join('')}</div>` : '';

    const tiposTxt = Object.keys(porTipo).map(v=>{
      const meta = TIP_BY_VALUE[v];
      return `<span class="asesor-preview-tipo">${meta?meta.label.replace('Agendado ',''):v} ×${porTipo[v]}</span>`;
    }).join('');

    el.innerHTML = `
      <div class="asesor-preview-title">Disponibilidad de hoy${!editingAsesorNombre?' (según el horario configurado)':''}</div>
      <div class="asesor-preview-body">
        <div class="asesor-preview-donut">${donutSvg}</div>
        <div class="asesor-preview-info">
          <div class="asesor-preview-summary">
            <span><strong class="tabular">${cupos}</strong> cupos</span>
            <span><strong class="tabular">${ocupado}</strong> ocupados${citasHoy?` (${citasHoy} cita${citasHoy===1?'':'s'})`:''}</span>
            <span><strong class="tabular">${disponible}</strong> disponibles</span>
          </div>
          ${stripHtml}
          <div class="slot-strip-legend">
            <span><i class="ok"></i>Disponible</span><span><i class="taken"></i>Ocupado</span><span><i class="lunch"></i>Almuerzo</span>
          </div>
          ${tiposTxt ? `<div class="asesor-preview-tipos">${tiposTxt}</div>` : ''}
        </div>
      </div>
    `;
  }

  function computeSlotStatusesForPreview(draft, fecha, asesorNombre){
    if(!draft.horaInicio || !draft.horaFin || !draft.intervaloMin) return [];
    const toMin = t=>{ const [h,m]=t.split(':').map(Number); return h*60+m; };
    const start = toMin(draft.horaInicio), end = toMin(draft.horaFin), step = +draft.intervaloMin;
    if(!(step>0) || end<=start) return [];
    const almIni = draft.almuerzoInicio ? toMin(draft.almuerzoInicio) : null;
    const almFin = draft.almuerzoFin ? toMin(draft.almuerzoFin) : null;
    const raw = [];
    for(let t=start; t+step<=end; t+=step){
      raw.push({
        time: String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'),
        lunch: (almIni!=null && almFin!=null && t<almFin && t+step>almIni)
      });
    }
    const workSlots = raw.filter(r=>!r.lunch).map(r=>r.time);
    const takenSlots = new Set();
    if(asesorNombre){
      gestionesMap.forEach(g=>{
        if(!ocupaAgenda(g) || g.asesorServicio!==asesorNombre || g.proximaGestion!==fecha || !g.horaCita) return;
        const idx = workSlots.indexOf(g.horaCita);
        if(idx===-1) return;
        const carga = getCarga(draft, g.tipificacion);
        for(let i=idx; i<idx+carga && i<workSlots.length; i++) takenSlots.add(workSlots[i]);
      });
    }
    return raw.map(r=> ({ time:r.time, status: r.lunch ? 'lunch' : (takenSlots.has(r.time) ? 'taken' : 'ok') }));
  }
