      errEl.textContent = `La suma de la carga repartida (${totalRepartido}) supera los ${cuposPlantilla} espacio(s) disponibles ese día (según el horario${topeMaxCitas!=null?' y el tope máximo de citas':''}). Ajústela antes de guardar.`;
      errEl.hidden = false;
      enforceCargaLimits(null);
      renderAsesorFormPreview();
      return;
