    errEl.hidden = true;
    const record = {nombre, codigo, taller, diasDisponibles, horaInicio, horaFin, intervaloMin, almuerzoInicio: almuerzoInicio||null, almuerzoFin: almuerzoFin||null, topeMaxCitas, cargaPorTipo, semanas: semanasEnc, franjas: []};
