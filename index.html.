  document.getElementById('btnAddAsesor').addEventListener('click', async ()=>{
    const errEl = document.getElementById('asesorFormErr');
    const nombre = document.getElementById('nuevoAsesorNombre').value.trim();
    const codigo = document.getElementById('nuevoAsesorCodigo').value.trim();
    const taller = document.getElementById('nuevoAsesorTaller').value;
    const horaInicio = document.getElementById('nuevoAsesorHoraInicio').value;
    const horaFin = document.getElementById('nuevoAsesorHoraFin').value;
    const intervaloMin = +document.getElementById('nuevoAsesorIntervalo').value;
    const diasDisponibles = formFechas.slice();
    const almuerzoInicio = document.getElementById('nuevoAsesorAlmuerzoInicio').value || '';
    const almuerzoFin = document.getElementById('nuevoAsesorAlmuerzoFin').value || '';
    if(!nombre){ errEl.textContent='Ingrese el nombre del asesor.'; errEl.hidden=false; return; }
    if(!agendaConfig.talleres.length){ errEl.textContent='Cree al menos un taller antes de agregar asesores.'; errEl.hidden=false; return; }
    if(!taller){ errEl.textContent='Seleccione el taller al que se asigna este asesor.'; errEl.hidden=false; return; }
    if(horaFin <= horaInicio){ errEl.textContent='La hora de fin debe ser posterior a la hora de inicio.'; errEl.hidden=false; return; }
    if((almuerzoInicio && !almuerzoFin) || (!almuerzoInicio && almuerzoFin)){ errEl.textContent='Complete el inicio y el fin del almuerzo, o deje ambos vacíos.'; errEl.hidden=false; return; }
    if(almuerzoInicio && almuerzoFin){
      if(almuerzoFin <= almuerzoInicio){ errEl.textContent='El fin del almuerzo debe ser posterior a su inicio.'; errEl.hidden=false; return; }
      if(almuerzoInicio < horaInicio || almuerzoFin > horaFin){ errEl.textContent='El horario de almuerzo debe estar dentro del horario de atención.'; errEl.hidden=false; return; }
    }
    const semanasEnc = {}; let errSem = null;
    Object.keys(formSemanas).sort().forEach(mon=>{
      Object.keys(formSemanas[mon]).forEach(dow=>{
        const d = formSemanas[mon][dow], f = addDaysIso(mon, (+dow+6)%7);
        if(!errSem){
          if(d.horaFin <= d.horaInicio) errSem = f+': la hora de fin debe ser posterior a la de inicio.';
          else if((d.almuerzoInicio && !d.almuerzoFin) || (!d.almuerzoInicio && d.almuerzoFin)) errSem = f+': complete el inicio y el fin del almuerzo, o deje ambos vacíos.';
          else if(d.almuerzoInicio && d.almuerzoFin && d.almuerzoFin <= d.almuerzoInicio) errSem = f+': el fin del almuerzo debe ser posterior a su inicio.';
        }
        (semanasEnc[mon] = semanasEnc[mon] || {})[dow] = encodeDia(d);
      });
    });
    if(errSem){ errEl.textContent = 'Agenda semanal — '+errSem; errEl.hidden = false; return; }
    const dup = agendaConfig.asesores.find(a=>a.nombre.toLowerCase()===nombre.toLowerCase() && a.nombre!==editingAsesorNombre);
