      {placa:'PSV345', km0:0,  ventaDaysAgo:900, visits:[[880,500],[700,9800],[520,18600],[340,27200],[160,35900]]},
      {placa:'PSW678', km0:0,  ventaDaysAgo:180, visits:[[170,350]]},
