  function readConfig(){
    return {
      regla: document.querySelector('input[name="regla"]:checked').value,
      kmPeriod: +document.getElementById('cfgKm').value || 10000,
      monthsPeriod: +document.getElementById('cfgMeses').value || 6,
      warnPct: (+document.getElementById('cfgAviso').value || 85)/100,
      assumedKmDay: +document.getElementById('cfgKmDia').value || 33
    };
  }

  function computeVehicle(v, cfg){
    const points = [];
    if(v.venta && v.venta.fecha) points.push({fecha:v.venta.fecha, km:0});
    (v.ingresos||[]).forEach(p=>points.push(p));
    points.sort((a,b)=>a.fecha-b.fecha);
    if(!points.length) return null;
    const first = points[0], last = points[points.length-1];
    let tasa, estimado=false;
    const spanDays = diffDays(first.fecha, last.fecha);
    if(points.length>=2 && spanDays>0 && last.km>=first.km){
      tasa = (last.km-first.km)/spanDays;
      if(tasa<=0){ tasa = cfg.assumedKmDay; estimado=true; }
    } else {
      tasa = cfg.assumedKmDay; estimado = true;
    }
    const today = new Date();
    const diasDesde = Math.max(0, diffDays(last.fecha, today));
    const kmRecorridos = tasa*diasDesde;
    const ratioKm = kmRecorridos/cfg.kmPeriod;
    const ratioTime = diasDesde/(cfg.monthsPeriod*30.44);
    let ratio;
    if(cfg.regla==='km') ratio = ratioKm;
    else if(cfg.regla==='tiempo') ratio = ratioTime;
    else ratio = Math.max(ratioKm, ratioTime);
    const motivo = ratioKm>=ratioTime ? 'Kilometraje' : 'Tiempo';
    const status = ratio>=1 ? 'vencido' : ratio>=cfg.warnPct ? 'proximo' : 'al_dia';
    const nuncaIngreso = (v.ingresos||[]).length===0;

    const kmRestantes = cfg.kmPeriod - kmRecorridos;
    const diasRestTime = (cfg.monthsPeriod*30.44) - diasDesde;
    const diasRestKm = tasa>0 ? kmRestantes/tasa : Infinity;
    let diasParaVencer;
    if(cfg.regla==='km') diasParaVencer = diasRestKm;
    else if(cfg.regla==='tiempo') diasParaVencer = diasRestTime;
    else diasParaVencer = Math.min(diasRestKm, diasRestTime);

    return {
      ...v, baseDate:last.fecha, baseKm:last.km, tasa, estimado, diasDesde,
      kmRecorridos, ratioKm, ratioTime, ratio, motivo, status, nuncaIngreso, diasParaVencer
    };
  }

