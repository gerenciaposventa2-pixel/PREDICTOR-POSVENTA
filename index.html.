      <div class="stat"><div class="num tabular">${total}</div><div class="lbl">Vehículos analizados</div></div>
      <div class="stat critical"><div class="num tabular">${vencidos}</div><div class="lbl">Vencidos</div></div>
      <div class="stat warn"><div class="num tabular">${proximos}</div><div class="lbl">Próximos a vencer</div></div>
      <div class="stat ok"><div class="num tabular">${aldia}</div><div class="lbl">Al día</div></div>
      <div class="stat neutral"><div class="num tabular">${nunca}</div><div class="lbl">Nunca ingresaron</div></div>
