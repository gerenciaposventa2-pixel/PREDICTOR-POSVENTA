  const STATUS_META = {
    vencido:{label:'Vencido', color:'critical'},
    proximo:{label:'Próximo', color:'warn'},
    al_dia:{label:'Al día', color:'ok'},
  };
  let activeFilter = 'todos', searchTerm='', sortMode='prioridad', activeMarca='todas';

  function marcaFilteredList(){
    return activeMarca==='todas' ? analyzed : analyzed.filter(v=>v.marca===activeMarca);
  }

  const BRAND_CATALOG = ['Kia','JMC','JAC','Mitsubishi','BYD','Honda','Volkswagen','JMEV','Jetour','Karry','HINO','DFSK','Citroën'];

  function renderMarcaOptions(){
    const sel = document.getElementById('marcaFilter');
    const marcasEnDatos = analyzed.map(v=>v.marca||'Sin marca');
    const marcas = Array.from(new Set([...BRAND_CATALOG, ...marcasEnDatos])).sort((a,b)=>a.localeCompare(b,'es'));
    const prev = activeMarca;
    sel.innerHTML = '<option value="todas">Todas las marcas</option>' +
      marcas.map(m=>`<option value="${m}">${m}</option>`).join('');
    activeMarca = marcas.includes(prev) ? prev : 'todas';
    sel.value = activeMarca;
  }

  function filteredSorted(){
    let list = marcaFilteredList();
    if(activeFilter==='nunca') list = list.filter(v=>v.nuncaIngreso);
    else if(activeFilter==='gestionado') list = list.filter(v=>gestionesMap.has(v.placa));
    else if(activeFilter==='sin_gestion') list = list.filter(v=>!gestionesMap.has(v.placa));
    else if(activeFilter==='agendado') list = list.filter(v=>{ const g=gestionesMap.get(v.placa); return g && g.categoria==='agendado'; });
    else if(activeFilter!=='todos') list = list.filter(v=>v.status===activeFilter);
    if(searchTerm){
      const t = norm(searchTerm);
      list = list.filter(v=> norm(v.cliente).includes(t) || norm(v.placa).includes(t) || norm(v.telefono).includes(t));
    }
    list.sort((a,b)=>{
      if(sortMode==='cliente') return a.cliente.localeCompare(b.cliente,'es');
      if(sortMode==='dias') return b.diasDesde - a.diasDesde;
      if(sortMode==='km') return b.kmRecorridos - a.kmRecorridos;
      return b.ratio - a.ratio;
    });
    return list;
  }

  function renderStats(){
    const base = marcaFilteredList();
    const total = base.length;
    const vencidos = base.filter(v=>v.status==='vencido').length;
    const proximos = base.filter(v=>v.status==='proximo').length;
    const aldia = base.filter(v=>v.status==='al_dia').length;
    const nunca = base.filter(v=>v.nuncaIngreso).length;
    const gestionados = base.filter(v=>gestionesMap.has(v.placa)).length;
