    const scheduleDraft = {horaInicio, horaFin, intervaloMin, almuerzoInicio: almuerzoInicio||null, almuerzoFin: almuerzoFin||null, topeMaxCitas};
    const cuposPlantilla = getEffectiveCupos(scheduleDraft);
    const cargaPorTipo = getCargaFromGrid();
    const totalRepartido = Object.values(cargaPorTipo).reduce((s,v)=>s+v,0);
