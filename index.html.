      {placa:'PST456', km0:0,  ventaDaysAgo:400, visits:[[390,250],[220,5100],[95,9800]]},
      {placa:'PSR789', km0:0,  ventaDaysAgo:650, visits:[[640,400],[470,6200],[290,11500],[130,16200]]},
