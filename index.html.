    }
    if(v.diasParaVencer <= 0) {
      const overdue = Math.abs(Math.round(v.diasParaVencer));
      return `Vencido hace ${overdue} día(s)`;
    }
    return `Faltan ~${Math.round(v.diasParaVencer)} día(s)`;
  }

