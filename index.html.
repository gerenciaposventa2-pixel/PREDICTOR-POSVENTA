    saveLocalAgenda();
    return false;
  }

  function renderTalleresChips(){
    const el = document.getElementById('talleresChips');
    const list = agendaConfig.talleres;
    if(!list.length){ el.innerHTML = '<span class="agenda-empty">Aún no hay ninguno registrado.</span>'; return; }
