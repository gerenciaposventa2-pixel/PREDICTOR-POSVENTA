  // ---------- disponibilidad de agenda (dashboard de llenado) ----------
  function renderDisponibilidad(){
    const fechaEl = document.getElementById('dispoFecha');
    if(!fechaEl.value) fechaEl.value = todayStr();
    const fecha = fechaEl.value;
    const tallerFiltro = document.getElementById('dispoTallerFilter').value || 'todos';
    let asesores = agendaConfig.asesores.slice();
    if(tallerFiltro!=='todos') asesores = asesores.filter(a=>a.taller===tallerFiltro);

    const rows = asesores.map(a=>{
      const trabaja = (a.diasDisponibles||[]).includes(fecha);
      const cupos = trabaja ? getEffectiveCupos(a, fecha) : 0;
      let citas = 0, carga = 0;
      gestionesMap.forEach(g=>{
        if(ocupaAgenda(g) && g.asesorServicio===a.nombre && g.proximaGestion===fecha){
          citas++; carga += getCarga(a, g.tipificacion);
        }
      });
      const disponibles = Math.max(0, cupos - carga);
      const pct = cupos ? Math.round(carga/cupos*100) : (carga>0 ? 100 : 0);
      return {a, trabaja, cupos, citas, carga, disponibles, pct};
    });

    const totalCupos = rows.reduce((s,r)=>s+r.cupos,0);
    const totalCitas = rows.reduce((s,r)=>s+r.citas,0);
    const totalCarga = rows.reduce((s,r)=>s+r.carga,0);
    const totalDisponibles = Math.max(0, totalCupos-totalCarga);
    const pctGlobal = totalCupos ? Math.round(totalCarga/totalCupos*100) : 0;

    document.getElementById('dispoStatGrid').innerHTML = `
      <div class="stat"><div class="num tabular">${totalCupos}</div><div class="lbl">Cupos del día</div></div>
      <div class="stat warn"><div class="num tabular">${totalCitas}</div><div class="lbl">Citas agendadas</div></div>
      <div class="stat ok"><div class="num tabular">${totalDisponibles}</div><div class="lbl">Disponibles</div></div>
      <div class="stat"><div class="num tabular">${pctGlobal}%</div><div class="lbl">Ocupación (por carga)</div></div>
    `;

    const tbody = document.getElementById('dispoBody');
    if(!rows.length){
      tbody.innerHTML = `<tr><td colspan="7"><div class="empty">No hay asesores configurados${tallerFiltro!=='todos'?' para este taller':''}.</div></td></tr>`;
      return;
    }
    tbody.innerHTML = rows.map(r=>{
      const barColor = r.pct>=100?'critical':r.pct>=70?'warn':'ok';
      return `<tr>
        <td class="cell-name">${r.a.nombre}</td>
        <td>${r.a.taller}</td>
        <td class="cell-sub">${r.trabaja ? (()=>{ const s = scheduleFor(r.a, fecha); return s.horaInicio+' – '+s.horaFin; })() : 'No atiende este día'}</td>
        <td class="mono tabular">${r.cupos}</td>
        <td class="mono tabular">${r.citas}${r.carga!==r.citas?` <span class="cell-sub">(carga ${r.carga})</span>`:''}</td>
        <td class="mono tabular">${r.disponibles}</td>
        <td>
          <div class="progress-row">
            <div class="progress"><span style="width:${Math.min(100,r.pct)}%; background:var(--${barColor})"></span></div>
            <span class="progress-pct">${r.pct}%</span>
          </div>
        </td>
      </tr>`;
    }).join('');
  }
  document.getElementById('dispoFecha').addEventListener('change', renderDisponibilidad);
  document.getElementById('dispoTallerFilter').addEventListener('change', renderDisponibilidad);

  // ---------- prospección de recuperación: gestiones que no terminaron agendadas ----------
  // quedan fuera quienes pidieron no ser contactados o ya vendieron el vehículo — no son prospecto.
  const RECUPERACION_EXCLUIDOS = ['no_contactar','vehiculo_vendido'];
  function esCandidatoRecuperacion(g){
    if(!g || RECUPERACION_EXCLUIDOS.includes(g.tipificacion)) return false;
    // una cita agendada solo cae a recuperación si el panel de Confirmación la dejó sin confirmar;
    // si asistió no vuelve a recuperación, y si no asistió cambia a tipificación "no_show" (ver marcarAsistencia),
    // que ya no es 'agendado' y por eso cae en la regla general de abajo.
    if(g.categoria==='agendado') return g.confirmacion==='no_confirmada';
    return true;
  }
  function recuperacionRows(){
    const rows = [];
    analyzed.forEach(v=>{
      const g = gestionesMap.get(v.placa);
      if(esCandidatoRecuperacion(g)) rows.push({ v, g, dias: Math.max(0, diffDays(new Date(g.fecha), new Date())) });
    });
    return rows;
  }
  let recSearchTerm = '', recTipoFilterVal = 'todos', recSortMode = 'antiguedad';

  function renderRecTipoOptions(rows){
    const sel = document.getElementById('recTipoFilter');
    const prev = sel.value;
    const tiposPresentes = TIPIFICACIONES.filter(t=> rows.some(r=>r.g.tipificacion===t.value));
    sel.innerHTML = '<option value="todos">Todas las tipificaciones</option>' +
      tiposPresentes.map(t=>`<option value="${t.value}">${t.label}</option>`).join('');
    if(tiposPresentes.some(t=>t.value===prev)) sel.value = prev; else recTipoFilterVal = 'todos';
  }

  function renderRecuperacion(){
    const allRows = recuperacionRows();
    renderRecTipoOptions(allRows);

    document.getElementById('recStatGrid').innerHTML = `
      <div class="stat"><div class="num tabular">${allRows.length}</div><div class="lbl">En recuperación</div></div>
      <div class="stat warn"><div class="num tabular">${allRows.filter(r=>r.g.categoria==='no_efectivo').length}</div><div class="lbl">Sin contacto efectivo</div></div>
      <div class="stat ok"><div class="num tabular">${allRows.filter(r=>r.g.categoria==='efectivo').length}</div><div class="lbl">Contactados, sin cita</div></div>
      <div class="stat critical"><div class="num tabular">${allRows.filter(r=>r.dias>=30).length}</div><div class="lbl">30+ días sin retomar</div></div>
    `;

    let rows = allRows.slice();
    if(recTipoFilterVal!=='todos') rows = rows.filter(r=>r.g.tipificacion===recTipoFilterVal);
    if(recSearchTerm){
      const t = norm(recSearchTerm);
      rows = rows.filter(r=> norm(r.v.cliente).includes(t) || norm(r.v.placa).includes(t) || norm(r.v.telefono).includes(t));
    }
    rows.sort((a,b)=>{
      if(recSortMode==='reciente') return a.dias - b.dias;
      if(recSortMode==='cliente') return a.v.cliente.localeCompare(b.v.cliente,'es');
      return b.dias - a.dias; // antigüedad: más días sin retomar primero
    });

    document.getElementById('recResultCount').textContent = `${rows.length} resultado(s)`;
    const tbody = document.getElementById('recuperacionBody');
    if(!rows.length){
      tbody.innerHTML = `<tr><td colspan="8"><div class="empty">No hay gestiones pendientes de recuperar con el filtro actual.</div></td></tr>`;
      return;
    }
    const puedeTipificar = !currentUser || canTipificar(currentUser.rol);
    const sinPermisoTxt = currentUser ? `Sin permiso para editar (rol: ${roleLabel(currentUser.rol)})` : 'Sin permiso';
    tbody.innerHTML = rows.map(({v,g,dias})=>`<tr>
      <td class="cell-name">${v.cliente||'—'}</td>
      <td>${v.telefono||'<span class="cell-sub">Sin dato</span>'}</td>
      <td>${v.placa}<div class="cell-sub">${[v.marca,v.modelo].filter(Boolean).join(' ')}</div></td>
      <td><span class="gestion-badge ${g.categoria}">${g.tipificacionLabel||g.tipificacion}${g.confirmacion==='no_confirmada'?' — sin confirmar':''}</span></td>
      <td class="cell-sub">${fmtDate(new Date(g.fecha))}</td>
      <td class="mono tabular">${dias}</td>
      <td class="cell-sub">${g.gestionadoPor||'—'}</td>
      <td>${puedeTipificar ? `<button class="btn-tip" type="button" data-tip-placa="${v.placa}">Reintentar</button>` : `<span class="cell-sub">${sinPermisoTxt}</span>`}</td>
    </tr>`).join('');
  }
  document.getElementById('recSearch').addEventListener('input', e=>{ recSearchTerm = e.target.value; renderRecuperacion(); });
  document.getElementById('recTipoFilter').addEventListener('change', e=>{ recTipoFilterVal = e.target.value; renderRecuperacion(); });
  document.getElementById('recSort').addEventListener('change', e=>{ recSortMode = e.target.value; renderRecuperacion(); });
  document.getElementById('recuperacionBody').addEventListener('click', e=>{
    const el = e.target.closest('[data-tip-placa]');
    if(el) openTipModal(el.dataset.tipPlaca);
  });
  document.getElementById('btnCopyRecuperacion').addEventListener('click', ()=>{
    let rows = recuperacionRows();
    if(recTipoFilterVal!=='todos') rows = rows.filter(r=>r.g.tipificacion===recTipoFilterVal);
    if(recSearchTerm){
      const t = norm(recSearchTerm);
      rows = rows.filter(r=> norm(r.v.cliente).includes(t) || norm(r.v.placa).includes(t) || norm(r.v.telefono).includes(t));
    }
    const headers = ['Cliente','Telefono','Placa','Marca','Modelo','Tipificacion','FechaGestion','DiasSinRetomar','GestionadoPor','Observacion'];
    const esc = s=>{ s=String(s==null?'':s); return /[;"\n]/.test(s) ? '"'+s.replace(/"/g,'""')+'"' : s; };
    const csvRows = rows.map(({v,g,dias})=>[
      v.cliente, v.telefono, v.placa, v.marca, v.modelo, g.tipificacionLabel||g.tipificacion,
      fmtDate(new Date(g.fecha)), dias, g.gestionadoPor||'', g.observacion||''
    ]);
    const csv = [headers.join(';')].concat(csvRows.map(r=>r.map(esc).join(';'))).join('\n');
    const ta = document.getElementById('copyText');
    ta.value = csv;
    document.getElementById('copyOverlay').hidden = false;
    ta.focus(); ta.select();
    if(navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(csv).catch(()=>{});
  });

  // ---------- reporte ejecutivo: panorama gráfico consolidado ----------
  function renderBarChart(containerId, items){
    const el = document.getElementById(containerId);
    if(!items.length){ el.innerHTML = '<div class="empty">Sin datos.</div>'; return; }
    const max = Math.max(...items.map(i=>i.value), 1);
    el.innerHTML = items.map(i=>{
      const pct = i.value<=0 ? 0 : Math.max(3, Math.round(i.value/max*100));
      return `<div class="exec-bar-row">
        <div class="exec-bar-label" title="${i.label}">${i.label}</div>
        <div class="exec-bar-track"><div class="exec-bar-fill" style="width:${pct}%; background:${i.color||'var(--accent)'}"></div></div>
        <div class="exec-bar-value tabular">${i.valueLabel!=null?i.valueLabel:i.value}</div>
      </div>`;
    }).join('');
  }

  // filtros combinables del reporte ejecutivo: período (por fecha de la gestión), taller, marca y asesor
  let ejPeriodo = 'todos', ejTallerFiltro = 'todos', ejMarcaFiltro = 'todos', ejAsesorFiltro = 'todos';

  function ejPeriodBounds(){
    if(ejPeriodo==='personalizado'){
      const dv = document.getElementById('ejDesde').value, hv = document.getElementById('ejHasta').value;
      return { desde: dv ? new Date(dv+'T00:00:00') : null, hasta: hv ? new Date(hv+'T23:59:59') : null };
    }
    const dias = { hoy:0, ult7:6, ult30:29, ult90:89 }[ejPeriodo];
    if(dias==null) return { desde:null, hasta:null };
    const desde = new Date(); desde.setHours(0,0,0,0); desde.setDate(desde.getDate()-dias);
    const hasta = new Date(); hasta.setHours(23,59,59,999);
    return { desde, hasta };
  }
  function ejEnPeriodo(g){
    if(!g) return false;
    const { desde, hasta } = ejPeriodBounds();
    if(!desde && !hasta) return true;
    const f = new Date(g.fecha);
    if(desde && f<desde) return false;
    if(hasta && f>hasta) return false;
    return true;
  }
  function ejVehiculos(){ return ejMarcaFiltro==='todos' ? analyzed : analyzed.filter(v=>v.marca===ejMarcaFiltro); }
  function ejEsAgendadoValido(g){
    if(!g || g.categoria!=='agendado' || !ejEnPeriodo(g)) return false;
    if(ejTallerFiltro!=='todos' && g.taller!==ejTallerFiltro) return false;
    if(ejAsesorFiltro!=='todos' && g.asesorServicio!==ejAsesorFiltro) return false;
    return true;
  }
  function ejFechasDelPeriodo(){
    const { desde, hasta } = ejPeriodBounds();
    if(!desde || !hasta) return [todayStr()]; // "todo el histórico": la ocupación se muestra para hoy
    const dias = [];
    const d = new Date(desde);
    let guard = 0;
    while(d<=hasta && guard<370){ dias.push(todayStrFrom(d)); d.setDate(d.getDate()+1); guard++; }
    return dias;
  }
  function todayStrFrom(d){ const p=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`; }

  function ejRefreshFilterOptions(){
    const fillSel = (selId, values, placeholder)=>{
      const sel = document.getElementById(selId);
      const prev = sel.value;
      sel.innerHTML = `<option value="todos">${placeholder}</option>` + values.map(v=>`<option value="${v}">${v}</option>`).join('');
      sel.value = values.includes(prev) ? prev : 'todos';
    };
    fillSel('ejTallerSelect', agendaConfig.talleres.slice().sort((a,b)=>a.localeCompare(b,'es')), 'Todos los talleres');
    const marcas = Array.from(new Set([...BRAND_CATALOG, ...analyzed.map(v=>v.marca||'Sin marca')])).sort((a,b)=>a.localeCompare(b,'es'));
    fillSel('ejMarcaSelect', marcas, 'Todas las marcas');
    let asesoresDisponibles = agendaConfig.asesores.slice();
    if(document.getElementById('ejTallerSelect').value!=='todos') asesoresDisponibles = asesoresDisponibles.filter(a=>a.taller===document.getElementById('ejTallerSelect').value);
    fillSel('ejAsesorSelect', asesoresDisponibles.map(a=>a.nombre).sort((a,b)=>a.localeCompare(b,'es')), 'Todos los asesores');
    ejTallerFiltro = document.getElementById('ejTallerSelect').value;
    ejMarcaFiltro = document.getElementById('ejMarcaSelect').value;
    ejAsesorFiltro = document.getElementById('ejAsesorSelect').value;
  }

  function renderEjecutivo(){
    ejRefreshFilterOptions();
    const vehiculos = ejVehiculos();
    const total = vehiculos.length;
    const gestiones = vehiculos.map(v=>gestionesMap.get(v.placa)).filter(g=>g && ejEnPeriodo(g));
    const contactados = gestiones.length;
    const contactoEfectivo = gestiones.filter(g=>g.categoria==='efectivo'||g.categoria==='agendado').length;
    const agendadosTotal = vehiculos.filter(v=>ejEsAgendadoValido(gestionesMap.get(v.placa))).length;
    const vencidos = vehiculos.filter(v=>v.status==='vencido').length;
    const recRows = recuperacionRows().filter(r=> (ejMarcaFiltro==='todos'||r.v.marca===ejMarcaFiltro) && ejEnPeriodo(r.g));

    // KPIs
    const pctGestionado = total ? Math.round(contactados/total*100) : 0;
    const pctAgendado = total ? Math.round(agendadosTotal/total*100) : 0;
    document.getElementById('ejStatGrid').innerHTML = `
      <div class="stat"><div class="num tabular">${total}</div><div class="lbl">Vehículos en el barrido</div></div>
      <div class="stat ok"><div class="num tabular">${pctGestionado}%</div><div class="lbl">Gestionados</div></div>
      <div class="stat" style="border-top-color:var(--accent)"><div class="num tabular">${pctAgendado}%</div><div class="lbl">Conversión a cita</div></div>
      <div class="stat critical"><div class="num tabular">${vencidos}</div><div class="lbl">Vencidos</div></div>
      <div class="stat warn"><div class="num tabular">${recRows.length}</div><div class="lbl">En recuperación</div></div>
    `;

    // embudo de gestión (el último tramo respeta también taller/asesor, si están elegidos)
    const etapas = [
      { l:'Vehículos en el barrido', n:total, color:'var(--neutral-status)' },
      { l:'Contactados', n:contactados, color:'var(--accent)' },
      { l:'Contacto efectivo', n:contactoEfectivo, color:'var(--accent-strong)' },
      { l:'Agendados', n:agendadosTotal, color:'var(--ok)' }
    ];
    document.getElementById('ejFunnel').innerHTML = etapas.map(e=>{
      const pct = total ? Math.round(e.n/total*100) : 0;
      const ancho = total ? Math.max(30, Math.round(e.n/total*100)) : 30;
      return `<div class="exec-funnel-stage" style="width:${ancho}%; background:${e.color};">
        <div class="efn-n tabular">${e.n} <span style="font-size:11px; font-weight:400;">(${pct}%)</span></div>
        <div class="efn-l">${e.l}</div>
      </div>`;
    }).join('');

    // recuperación por antigüedad (donut)
    const b0 = recRows.filter(r=>r.dias<8).length;
    const b1 = recRows.filter(r=>r.dias>=8 && r.dias<31).length;
    const b2 = recRows.filter(r=>r.dias>=31).length;
    const totalRec = b0+b1+b2;
    const r=34, cx=40, cy=40, sw=11, circunf=2*Math.PI*r;
    let cum=0, rings='';
    [[b0,'var(--ok)'],[b1,'var(--warn)'],[b2,'var(--critical)']].forEach(([v,color])=>{
      if(v<=0) return;
      const len = (v/(totalRec||1))*circunf;
      rings += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:${color}" stroke-width="${sw}" stroke-dasharray="${len} ${circunf-len}" stroke-dashoffset="${-cum}" transform="rotate(-90 ${cx} ${cy})"></circle>`;
      cum += len;
    });
    if(totalRec===0) rings = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" style="stroke:var(--border)" stroke-width="${sw}"></circle>`;
    document.getElementById('ejRecuperacionDonut').innerHTML = `
      <div class="carga-donut-svg"><svg viewBox="0 0 80 80" width="76" height="76">${rings}
        <text x="40" y="45" text-anchor="middle" font-size="15" font-weight="700" style="fill:var(--text); font-family:var(--font-mono)">${totalRec}</text>
      </svg></div>
      <div class="carga-legend">
        <span class="carga-legend-item"><i style="background:var(--ok)"></i>0–7 días · ${b0}</span>
        <span class="carga-legend-item"><i style="background:var(--warn)"></i>8–30 días · ${b1}</span>
        <span class="carga-legend-item"><i style="background:var(--critical)"></i>31+ días · ${b2}</span>
      </div>`;

    // conversión por marca (respeta período; si ya hay una marca elegida, queda una sola barra)
    const porMarca = new Map();
    vehiculos.forEach(v=>{
      const m = v.marca || 'Sin marca';
      if(!porMarca.has(m)) porMarca.set(m, {total:0, ok:0});
      const g = porMarca.get(m);
      g.total++;
      const ges = gestionesMap.get(v.placa);
      if(ges && ejEnPeriodo(ges) && (ges.categoria==='agendado'||ges.categoria==='efectivo')) g.ok++;
    });
    const marcaItems = Array.from(porMarca.entries())
      .map(([m,g])=>({ label:m, value: g.total? Math.round(g.ok/g.total*100) : 0, valueLabel:`${g.total? Math.round(g.ok/g.total*100):0}% (${g.total})`, color:'var(--accent)' }))
      .sort((a,b)=>b.value-a.value);
    renderBarChart('ejMarcaChart', marcaItems);

    // ocupación de agenda por asesor, sumada sobre las fechas del período (taller/asesor sí filtran aquí)
    const fechasPeriodo = ejFechasDelPeriodo();
    let asesoresBase = agendaConfig.asesores.slice();
    if(ejTallerFiltro!=='todos') asesoresBase = asesoresBase.filter(a=>a.taller===ejTallerFiltro);
    if(ejAsesorFiltro!=='todos') asesoresBase = asesoresBase.filter(a=>a.nombre===ejAsesorFiltro);
    const asesorItems = asesoresBase.map(a=>{
      let cupos=0, carga=0;
      fechasPeriodo.forEach(fecha=>{
        if((a.diasDisponibles||[]).includes(fecha)) cupos += getEffectiveCupos(a, fecha);
        gestionesMap.forEach(g=>{ if(ocupaAgenda(g) && g.asesorServicio===a.nombre && g.proximaGestion===fecha) carga += getCarga(a, g.tipificacion); });
      });
      const pct = cupos ? Math.round(carga/cupos*100) : 0;
      return { label:a.nombre, value: pct, valueLabel:`${pct}%`, color: pct>=100?'var(--critical)':pct>=70?'var(--warn)':'var(--ok)' };
    }).sort((a,b)=>b.value-a.value);
    renderBarChart('ejAsesorChart', asesorItems);

    // agendados por tipo (respeta los cuatro filtros)
    const agendadoItems = TIPIFICACIONES.filter(t=>t.categoria==='agendado').map(t=>{
      let n=0;
      vehiculos.forEach(v=>{ const g=gestionesMap.get(v.placa); if(g && g.tipificacion===t.value && ejEsAgendadoValido(g)) n++; });
      return { label:t.label.replace('Agendado ',''), value:n, color:'var(--accent)' };
    }).filter(i=>i.value>0).sort((a,b)=>b.value-a.value);
    renderBarChart('ejAgendadoChart', agendadoItems);
  }

  document.getElementById('ejPeriodoSelect').addEventListener('change', e=>{
    ejPeriodo = e.target.value;
    const esPersonalizado = ejPeriodo==='personalizado';
    document.getElementById('ejDesde').hidden = !esPersonalizado;
    document.getElementById('ejHasta').hidden = !esPersonalizado;
    renderEjecutivo();
  });
  document.getElementById('ejDesde').addEventListener('change', renderEjecutivo);
  document.getElementById('ejHasta').addEventListener('change', renderEjecutivo);
  document.getElementById('ejTallerSelect').addEventListener('change', renderEjecutivo);
  document.getElementById('ejMarcaSelect').addEventListener('change', renderEjecutivo);
  document.getElementById('ejAsesorSelect').addEventListener('change', renderEjecutivo);
  document.getElementById('btnResetEjFiltros').addEventListener('click', ()=>{
    ejPeriodo = 'todos';
    document.getElementById('ejPeriodoSelect').value = 'todos';
    document.getElementById('ejDesde').hidden = true; document.getElementById('ejDesde').value = '';
    document.getElementById('ejHasta').hidden = true; document.getElementById('ejHasta').value = '';
    document.getElementById('ejTallerSelect').value = 'todos';
    document.getElementById('ejMarcaSelect').value = 'todos';
    document.getElementById('ejAsesorSelect').value = 'todos';
    renderEjecutivo();
  });

  // ---------- citas agendadas: informe de visualización por taller, asesor, marca, fecha y horario ----------
  let citTallerFiltro = 'todos', citAsesorFiltro = 'todos', citMarcaFiltro = 'todos';
  function citRefreshFilterOptions(){
    const fillSel = (selId, values, placeholder)=>{
      const sel = document.getElementById(selId);
      const prev = sel.value;
      sel.innerHTML = `<option value="todos">${placeholder}</option>` + values.map(v=>`<option value="${v}">${v}</option>`).join('');
      sel.value = values.includes(prev) ? prev : 'todos';
    };
    fillSel('citTallerSelect', agendaConfig.talleres.slice().sort((a,b)=>a.localeCompare(b,'es')), 'Todos los talleres');
    const marcas = Array.from(new Set([...BRAND_CATALOG, ...analyzed.map(v=>v.marca||'Sin marca')])).sort((a,b)=>a.localeCompare(b,'es'));
    fillSel('citMarcaSelect', marcas, 'Todas las marcas');
    let asesoresDisponibles = agendaConfig.asesores.slice();
    if(document.getElementById('citTallerSelect').value!=='todos') asesoresDisponibles = asesoresDisponibles.filter(a=>a.taller===document.getElementById('citTallerSelect').value);
    fillSel('citAsesorSelect', asesoresDisponibles.map(a=>a.nombre).sort((a,b)=>a.localeCompare(b,'es')), 'Todos los asesores');
    citTallerFiltro = document.getElementById('citTallerSelect').value;
    citMarcaFiltro = document.getElementById('citMarcaSelect').value;
    citAsesorFiltro = document.getElementById('citAsesorSelect').value;
  }
  function citasFilteredRows(){
    const desde = document.getElementById('citDesde').value || null;
    const hasta = document.getElementById('citHasta').value || null;
    const horaDesde = document.getElementById('citHoraDesde').value || null;
    const horaHasta = document.getElementById('citHoraHasta').value || null;
    const rows = [];
    gestionesMap.forEach(g=>{
      if(g.categoria!=='agendado' || !g.proximaGestion) return;
      if(citTallerFiltro!=='todos' && g.taller!==citTallerFiltro) return;
      if(citAsesorFiltro!=='todos' && g.asesorServicio!==citAsesorFiltro) return;
      if(desde && g.proximaGestion<desde) return;
      if(hasta && g.proximaGestion>hasta) return;
      if(horaDesde && (!g.horaCita || g.horaCita<horaDesde)) return;
      if(horaHasta && (!g.horaCita || g.horaCita>horaHasta)) return;
      const v = analyzed.find(a=>a.placa===g.placa);
      const marca = v ? (v.marca||'Sin marca') : 'Sin marca';
      if(citMarcaFiltro!=='todos' && marca!==citMarcaFiltro) return;
      rows.push({ g, v, marca });
    });
    rows.sort((a,b)=> (a.g.proximaGestion+' '+(a.g.horaCita||'')).localeCompare(b.g.proximaGestion+' '+(b.g.horaCita||'')));
    return rows;
  }
  function citaEstadoLabel(g){
