  function todayStr(){ const d=new Date(); const p=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`; }
  function ocupaAgenda(g){ return g.categoria==='agendado' && g.confirmacion!=='no_confirmada'; }
  function getCarga(asesor, tipificacion){
    const v = asesor && asesor.cargaPorTipo ? asesor.cargaPorTipo[tipificacion] : undefined;
    return (v==null) ? 1 : Math.max(0, v); // sin configurar => 1 por defecto; 0 explícito => sin cupo para ese tipo
  }
  // horario efectivo de un asesor en una fecha: el primer "horario especial" (franja) que coincida con el día de
  // la semana y el rango de fechas; si ninguno coincide (o no se da fecha) se usa el horario general del asesor.
  function scheduleFor(asesor, fecha){
    if(asesor && fecha && asesor.semanas){
      const wk = asesor.semanas[mondayOf(fecha)];
      const dia = wk && wk[new Date(fecha+'T00:00:00').getDay()];
      if(dia) return decodeDia(dia);
    }
    if(asesor && fecha && Array.isArray(asesor.franjas) && asesor.franjas.length){
      const dow = new Date(fecha+'T00:00:00').getDay(); // 0 = domingo
      const f = asesor.franjas.find(f=>
        (!f.desde || fecha>=f.desde) && (!f.hasta || fecha<=f.hasta) && (!Array.isArray(f.dias) || f.dias.includes(dow)));
      if(f) return f;
    }
    return asesor;
  }
  function computeSlotsForAsesor(asesorBase, fecha){
    const asesor = scheduleFor(asesorBase, fecha);
    if(!asesor || !asesor.horaInicio || !asesor.horaFin || !asesor.intervaloMin) return [];
    const toMin = t=>{ const [h,m]=t.split(':').map(Number); return h*60+m; };
    const start = toMin(asesor.horaInicio), end = toMin(asesor.horaFin), step = +asesor.intervaloMin;
    if(!(step>0) || end<=start) return [];
    const almIni = asesor.almuerzoInicio ? toMin(asesor.almuerzoInicio) : null;
    const almFin = asesor.almuerzoFin ? toMin(asesor.almuerzoFin) : null;
    const slots = [];
    for(let t=start; t+step<=end; t+=step){
      if(almIni!=null && almFin!=null && t < almFin && t+step > almIni) continue; // se traslapa con el almuerzo
      slots.push(String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0'));
    }
    return slots;
  }

  // espacios ya ocupados de un asesor en una fecha, bloqueando tantos espacios consecutivos como indique
  // la carga de cada cita ya agendada (excluye la placa que se está editando, si aplica).
  function computeTakenSet(asesor, fecha, excludePlaca){
    const slots = computeSlotsForAsesor(asesor, fecha);
    const taken = new Set();
    gestionesMap.forEach((g,placa)=>{
      if(placa===excludePlaca) return;
      if(!ocupaAgenda(g) || g.asesorServicio!==asesor.nombre || g.proximaGestion!==fecha || !g.horaCita) return;
      const idx = slots.indexOf(g.horaCita);
      if(idx===-1) return;
      const carga = getCarga(asesor, g.tipificacion);
      for(let i=idx; i<idx+carga && i<slots.length; i++) taken.add(slots[i]);
    });
    return {slots, taken};
  }

  // ¿cabe una cita de esta carga, empezando en horaCita, sin chocar con lo ya ocupado ni salirse del horario?
  function slotFits(asesor, fecha, horaCita, carga, excludePlaca){
    if(carga<=0) return false; // sin cupo asignado a este tipo de agendamiento
    const {slots, taken} = computeTakenSet(asesor, fecha, excludePlaca);
    const idx = slots.indexOf(horaCita);
    if(idx===-1) return false;
    for(let k=idx; k<idx+carga; k++){
      if(k>=slots.length || taken.has(slots[k])) return false;
    }
    return true;
  }

