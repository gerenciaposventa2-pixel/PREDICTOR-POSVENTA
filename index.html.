  // agenda semanal del asesor: cada semana se configura día por día (atiende o no, periodicidad, horario, almuerzo)
  const MESES_LARGO = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const DISPLAY_ORDER = ['lun','mar','mie','jue','vie','sab','dom'];
  function fechaStr(y,m,d){ const p=n=>String(n).padStart(2,'0'); return `${y}-${p(m+1)}-${p(d)}`; }
  const SEM_DIAS = [[1,'Lunes'],[2,'Martes'],[3,'Miércoles'],[4,'Jueves'],[5,'Viernes'],[6,'Sábado'],[0,'Domingo']];
  function isoOf(d){ const p=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`; }
  function addDaysIso(iso, n){ const d = new Date(iso+'T00:00:00'); d.setDate(d.getDate()+n); return isoOf(d); }
  function mondayOf(iso){ const d = new Date(iso+'T00:00:00'); d.setDate(d.getDate()-((d.getDay()+6)%7)); return isoOf(d); }
  // un día se guarda compacto como "inicio|fin|periodicidad|almuerzoInicio|almuerzoFin" para no inflar el documento compartido
  function encodeDia(c){ return [c.horaInicio, c.horaFin, c.intervaloMin, c.almuerzoInicio||'', c.almuerzoFin||''].join('|'); }
  function decodeDia(s){
    if(typeof s!=='string') return s;
    const [hi,hf,iv,ai,af] = s.split('|');
    return { horaInicio:hi, horaFin:hf, intervaloMin:+iv, almuerzoInicio:ai||null, almuerzoFin:af||null };
  }
  function normalizeDia(f){
    const step = +f.intervaloMin || 30; f.intervaloMin = step;
    const ini = buildDayTimeOptions(step);
    if(!ini.includes(f.horaInicio)) f.horaInicio = ini.includes('08:00') ? '08:00' : ini[0];
    const fin = buildAfterTimeOptions(f.horaInicio, step);
    if(!fin.includes(f.horaFin)) f.horaFin = fin.includes('17:00') ? '17:00' : (fin[fin.length-1] || f.horaInicio);
    const alm = buildAfterTimeOptions(f.horaInicio, step, f.horaFin);
    if(!alm.includes(f.almuerzoInicio)) f.almuerzoInicio = '';
    if(!alm.includes(f.almuerzoFin)) f.almuerzoFin = '';
    return f;
  }
  function semanasFromAsesor(a){
    const out = {};
    if(a.semanas){
      Object.keys(a.semanas).forEach(mon=>{
        out[mon] = {};
        Object.keys(a.semanas[mon]).forEach(dow=>{ out[mon][dow] = decodeDia(a.semanas[mon][dow]); });
      });
      return out;
    }
    // asesores creados antes de la agenda semanal: se arma cada semana desde sus días y horario guardados
    (a.diasDisponibles||[]).forEach(f=>{
      const s = scheduleFor(a, f), mon = mondayOf(f), dow = new Date(f+'T00:00:00').getDay();
      (out[mon] = out[mon] || {})[dow] = { horaInicio:s.horaInicio, horaFin:s.horaFin, intervaloMin:+s.intervaloMin, almuerzoInicio:s.almuerzoInicio||null, almuerzoFin:s.almuerzoFin||null };
    });
    return out;
  }

  let formSemanas = {};          // { [lunes ISO]: { [díaSemana 0-6]: {horaInicio,horaFin,intervaloMin,almuerzoInicio,almuerzoFin} } }
  let formWeekMonday = mondayOf(todayStr());
  let formFechas = [];           // fechas con atención, derivadas de formSemanas
  let semCopyN = 4;

  function syncFormFechas(){
    const out = [];
    Object.keys(formSemanas).forEach(mon=>{
      Object.keys(formSemanas[mon]).forEach(dow=>{ out.push(addDaysIso(mon, (+dow+6)%7)); });
    });
    formFechas = out.sort();
  }
  function setFormSemanas(obj){
    formSemanas = obj; formWeekMonday = mondayOf(todayStr());
    syncFormFechas(); renderSemanaPlanner();
  }
  function fmtRangoSemana(mon){
    const a = new Date(mon+'T00:00:00'), b = new Date(addDaysIso(mon,6)+'T00:00:00');
    const mes = d=>MESES_LARGO[d.getMonth()].toLowerCase();
    return a.getMonth()===b.getMonth()
      ? `${a.getDate()} al ${b.getDate()} de ${mes(b)} de ${b.getFullYear()}`
      : `${a.getDate()} de ${mes(a)} al ${b.getDate()} de ${mes(b)} de ${b.getFullYear()}`;
  }
  function cloneSemana(wk){ const o = {}; Object.keys(wk||{}).forEach(k=>{ o[k] = { ...wk[k] }; }); return o; }
  function setSemana(mon, wk){ if(Object.keys(wk).length) formSemanas[mon] = wk; else delete formSemanas[mon]; }

  function renderSemanaPlanner(){
    const el = document.getElementById('semanaPlanner');
    const wk = formSemanas[formWeekMonday] || {};
    const opts = (list, val, blank)=> (blank?'<option value="">— Ninguno —</option>':'') + list.map(o=>`<option value="${o}" ${o===val?'selected':''}>${o}</option>`).join('');
    const rows = SEM_DIAS.map(([dow,label])=>{
      const fecha = addDaysIso(formWeekMonday, (dow+6)%7);
      const [, mm, dd] = fecha.split('-');
      const d = wk[dow];
      const head = `<td class="sem-day"><label class="perm-chip"><input type="checkbox" data-sem-dia="${dow}" ${d?'checked':''}><strong>${label}</strong> <span class="agenda-empty">${dd}/${mm}</span></label></td>`;
      if(!d) return `<tr class="sem-off${(dow===0||dow===6)?' sem-finde':''}">${head}<td colspan="5" class="agenda-empty">No atiende</td></tr>`;
      normalizeDia(d);
      const alm = buildAfterTimeOptions(d.horaInicio, d.intervaloMin, d.horaFin);
      return `<tr class="${(dow===0||dow===6)?'sem-finde':''}">${head}
        <td><select data-sem-field="intervaloMin" data-dow="${dow}">${[15,20,30,45,60,90].map(n=>`<option value="${n}" ${n===d.intervaloMin?'selected':''}>${n} min</option>`).join('')}</select></td>
        <td><select data-sem-field="horaInicio" data-dow="${dow}">${opts(buildDayTimeOptions(d.intervaloMin), d.horaInicio)}</select></td>
        <td><select data-sem-field="horaFin" data-dow="${dow}">${opts(buildAfterTimeOptions(d.horaInicio, d.intervaloMin), d.horaFin)}</select></td>
        <td><select data-sem-field="almuerzoInicio" data-dow="${dow}">${opts(alm, d.almuerzoInicio, true)}</select></td>
        <td><select data-sem-field="almuerzoFin" data-dow="${dow}">${opts(alm, d.almuerzoFin, true)}</select></td>
      </tr>`;
    }).join('');
    const semanasConf = Object.keys(formSemanas).length, diasConf = formFechas.length;
    el.innerHTML = `
      <div class="sem-nav">
        <button type="button" class="btn btn-ghost" data-sem-act="prev" aria-label="Semana anterior">‹</button>
        <strong>Semana del ${fmtRangoSemana(formWeekMonday)}</strong>
        <button type="button" class="btn btn-ghost" data-sem-act="next" aria-label="Semana siguiente">›</button>
        <button type="button" class="btn btn-ghost" data-sem-act="hoy">Esta semana</button>
      </div>
      <div class="sem-actions">
        <button type="button" class="btn btn-ghost" data-sem-act="plantilla">Llenar Lun–Vie con la plantilla</button>
        <button type="button" class="btn btn-ghost" data-sem-act="prevcopy">Copiar la semana anterior</button>
        <span class="sem-copy">Copiar esta semana a las próximas <input type="number" id="semCopyN" min="1" max="52" value="${semCopyN}"> semanas <button type="button" class="btn btn-ghost" data-sem-act="copiar">Copiar</button></span>
        <button type="button" class="btn btn-ghost" data-sem-act="limpiar">Limpiar semana</button>
      </div>
      <div class="table-wrap"><table class="sem-table">
        <thead><tr><th>Día</th><th>Periodicidad</th><th>Hora inicio</th><th>Hora fin</th><th>Inicio almuerzo</th><th>Fin almuerzo</th></tr></thead>
        <tbody>${rows}</tbody>
      </table></div>
      <p class="agenda-empty" style="margin-top:6px;">${diasConf ? `${diasConf} día(s) con atención en ${semanasConf} semana(s) configurada(s).` : 'Aún no hay días configurados para este asesor.'}</p>`;
  }
  function planChanged(){ syncFormFechas(); renderSemanaPlanner(); renderAsesorFormPreview(); }

  document.getElementById('semanaPlanner').addEventListener('click', e=>{
    const btn = e.target.closest('[data-sem-act]'); if(!btn) return;
    const act = btn.dataset.semAct;
    if(act==='prev'){ formWeekMonday = addDaysIso(formWeekMonday, -7); renderSemanaPlanner(); }
    else if(act==='next'){ formWeekMonday = addDaysIso(formWeekMonday, 7); renderSemanaPlanner(); }
    else if(act==='hoy'){ formWeekMonday = mondayOf(todayStr()); renderSemanaPlanner(); }
    else if(act==='plantilla'){
      const t = readScheduleDraft();
      const wk = formSemanas[formWeekMonday] ? cloneSemana(formSemanas[formWeekMonday]) : {};
      [1,2,3,4,5].forEach(dow=>{ wk[dow] = normalizeDia({ horaInicio:t.horaInicio, horaFin:t.horaFin, intervaloMin:t.intervaloMin, almuerzoInicio:t.almuerzoInicio||'', almuerzoFin:t.almuerzoFin||'' }); });
      setSemana(formWeekMonday, wk); planChanged();
    }
    else if(act==='prevcopy'){
      const src = formSemanas[addDaysIso(formWeekMonday, -7)];
      if(!src){ alert('La semana anterior no tiene días configurados.'); return; }
      setSemana(formWeekMonday, cloneSemana(src)); planChanged();
    }
    else if(act==='copiar'){
      const src = formSemanas[formWeekMonday];
      if(!src){ alert('Esta semana no tiene días configurados para copiar.'); return; }
      for(let i=1; i<=semCopyN; i++) setSemana(addDaysIso(formWeekMonday, 7*i), cloneSemana(src));
      planChanged();
    }
    else if(act==='limpiar'){ delete formSemanas[formWeekMonday]; planChanged(); }
  });
  document.getElementById('semanaPlanner').addEventListener('change', e=>{
    if(e.target.id==='semCopyN'){ semCopyN = Math.min(52, Math.max(1, parseInt(e.target.value,10)||1)); return; }
    const wk = formSemanas[formWeekMonday] ? cloneSemana(formSemanas[formWeekMonday]) : {};
    if(e.target.dataset.semDia!=null){
