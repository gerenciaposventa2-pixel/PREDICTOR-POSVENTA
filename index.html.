  function cfgForVehicle(v){
    const ov = marcaPeriodicidad[v.marca];
    if(!ov) return null;
    if(ov.mode==='split'){
      const anioVenta = v.venta && v.venta.fecha ? v.venta.fecha.getFullYear() : null;
      // sin fecha de venta conocida, se asume el bloque "hasta" (más conservador que dejarlo sin personalizar)
      return (anioVenta!=null && anioVenta>=ov.anioCorte) ? ov.desde : ov.antes;
    }
    return ov;
  }
  function origenPeriodicidad(v){
    const ov = marcaPeriodicidad[v.marca];
    if(!ov) return 'Periodicidad general';
    if(ov.mode !== 'split') return v.marca;
    const anioVenta = v.venta && v.venta.fecha ? v.venta.fecha.getFullYear() : null;
    if(anioVenta == null) return v.marca + ' · sin fecha de venta (usa "hasta ' + (ov.anioCorte-1) + '")';
