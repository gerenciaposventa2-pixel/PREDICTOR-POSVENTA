  // el cupo real de un día es el del horario, salvo que el asesor tenga un tope de citas más bajo.
  function getEffectiveCupos(asesor, fecha){
    const base = computeSlotsForAsesor(asesor, fecha).length;
    const tope = asesor && asesor.topeMaxCitas;
    return (tope!=null && tope>0) ? Math.min(base, tope) : base;
  }
  // cuántas citas (de cualquier tipo) ya tiene agendadas un asesor en una fecha — el tope aplica al total,
  // no por tipo.
  function citasCountForDate(asesorNombre, fecha, excludePlaca){
    let n = 0;
    gestionesMap.forEach((g,placa)=>{
      if(placa===excludePlaca) return;
      if(ocupaAgenda(g) && g.asesorServicio===asesorNombre && g.proximaGestion===fecha) n++;
    });
    return n;
