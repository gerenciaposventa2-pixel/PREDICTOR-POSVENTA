  // ---------- selección de horario dentro del modal de tipificación ----------
  function renderTipSlotPicks(){
    const asesorNombre = document.getElementById('tipAsesorServicio').value;
    const fecha = document.getElementById('tipProxima').value;
    const wrap = document.getElementById('tipSlotPicks');
    const note = document.getElementById('tipSlotNote');
    const horaInput = document.getElementById('tipHoraCita');
    wrap.innerHTML = ''; note.textContent = ''; note.classList.remove('alert');
    const bloquear = (msg)=>{
      note.textContent = msg;
      note.classList.add('alert');
      horaInput.value = '';
    };
    if(!asesorNombre || !fecha){
      note.textContent = 'Elija primero el Asesor de Servicio y la fecha de la cita para ver los horarios disponibles según su periodicidad configurada.';
      horaInput.value = '';
      return;
    }
    const asesor = agendaConfig.asesores.find(a=>a.nombre===asesorNombre);
    if(!asesor){ bloquear('El asesor seleccionado ya no existe en la configuración de agenda.'); return; }
    if(!(asesor.diasDisponibles||[]).includes(fecha)){
      bloquear(`${asesor.nombre} no tiene el ${fecha} habilitado en su calendario de disponibilidad — elija otra fecha o asesor.`);
      return;
    }
    const citasHoyAsesor = citasCountForDate(asesorNombre, fecha, currentTipPlaca);
    const topeEfectivo = getEffectiveCupos(asesor, fecha);
    if(citasHoyAsesor >= topeEfectivo){
      bloquear(`${asesor.nombre} ya alcanzó su tope de ${topeEfectivo} cita(s) para el ${fecha} — no hay capacidad. Elija otra fecha u otro asesor.`);
      return;
    }
    const slots = computeSlotsForAsesor(asesor, fecha);
    if(!slots.length){ bloquear(`${asesor.nombre} no tiene un horario válido configurado (revise horario, periodicidad y almuerzo en Configuración de agenda).`); return; }

    const tipActual = document.getElementById('tipSelect').value;
    const cargaActual = getCarga(asesor, tipActual);
    if(cargaActual<=0){
      bloquear(`${asesor.nombre} no tiene cupo asignado para "${TIP_BY_VALUE[tipActual]?TIP_BY_VALUE[tipActual].label:tipActual}" (carga en 0 en el reparto) — ajuste el reparto en Configuración de agenda antes de agendar este tipo.`);
      return;
    }
    const { taken } = computeTakenSet(asesor, fecha, currentTipPlaca);

    const current = horaInput.value;
    let hayDisponible = false;
    wrap.innerHTML = slots.map((s,i)=>{
      let cabe = true;
      for(let k=i; k<i+cargaActual; k++){ if(k>=slots.length || taken.has(slots[k])){ cabe=false; break; } }
      const bloqueado = taken.has(s) || !cabe;
      if(!bloqueado) hayDisponible = true;
      return `<button type="button" class="slot-pick ${bloqueado?'taken':''} ${s===current?'chosen':''}" data-slot="${s}" ${bloqueado?'disabled':''}>${s}</button>`;
    }).join('');
    if(!hayDisponible){
      bloquear(`${asesor.nombre} no tiene horarios libres ese día que alcancen los ${cargaActual} espacio(s) consecutivos que requiere esta tipificación — elija otra fecha u otro asesor.`);
      return;
    }
    if(current && !slots.includes(current)) horaInput.value = '';
    if(cargaActual>1) note.textContent = `Esta tipificación ocupa ${cargaActual} espacios consecutivos del asesor. Elija un horario de la lista.`;
    else if(!note.textContent) note.textContent = 'Elija un horario de la lista.';
  }
